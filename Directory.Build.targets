<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Roof uses ordinary views, including its own InstallerWizard, never Terminal.Gui's Code, Markdown,
       Wizard or WizardStep. Mirror SkyMonitor bf5ef211's scoped exclusion (#172). Keep Markdig and the
       other required dependencies. Tests execute these programs in-process with the same exclusion. -->
  <ItemGroup Condition="'$(HvoTerminalProgram)' == 'true' or '$(MSBuildProjectName)' == 'HVO.RoofControllerV4.TerminalUi' or '@(ProjectReference->WithMetadataValue('Filename', 'HVO.RoofControllerV4.TerminalUi'))' != ''">
    <PackageReference Include="TextMateSharp" ExcludeAssets="all" />
    <PackageReference Include="TextMateSharp.Grammars" ExcludeAssets="all" />
    <PackageReference Include="Onigwrap" ExcludeAssets="all" />
  </ItemGroup>
  <!-- Self-contained outputs carry the patched runtime even with the pinned older SDK. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' and '$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>
  <!--
    A build that names its version (-p:Version=..., as a release build does) must name the product version in
    Directory.Build.props or a prerelease of it, so a tag cannot ship a program that says another version.
  -->
  <Target Name="RoofCheckProductVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Version)' != '$(VersionPrefix)' and !$([System.String]::Copy('$(Version)').StartsWith('$(VersionPrefix)-'))"
           Text="Version $(Version) is not the product version $(VersionPrefix) (Directory.Build.props) or a prerelease of it. If you did not pass -p:Version, a VERSION environment variable set it (MSBuild reads environment variables as properties, ignoring case): unset it." />
  </Target>
</Project>
