<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Label="Language and Framework Defaults">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The product version (docs/releasing.md): one version for every program and image, the next release's. A release
    tag vX.Y.Z must match it (build/version.sh), and a release's builds are X.Y.Z or X.Y.Z-rc.N. Every other build is
    a prerelease of it. CI's dotnet builds set the Version environment variable, to X.Y.Z-ci.<run> or, when the release
    workflow runs CI, to the release's version. Image builds pass the whole version (ROOF_VERSION, as -p:Version), and
    anything else gets the -dev default here. The SDK adds the commit to the informational version (4.0.0-dev+<sha>)
    from the checkout, or from -p:SourceRevisionId in an image.
  -->
  <PropertyGroup Label="Product Version">
    <VersionPrefix>4.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Version)' == ''">dev</VersionSuffix>
    <Product>HVO Roof Controller</Product>
    <Company>Hualapai Valley Observatory</Company>
  </PropertyGroup>

  <PropertyGroup Label="Suppressed Warnings">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NoWarn>$(NoWarn);CS1030</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="NuGet Audit Exceptions">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <PropertyGroup Label="Build Output">
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Code Quality">
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Label="Performance">
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release' and '$(IsPublishable)' == 'true'">false</PublishTrimmed>
  </PropertyGroup>
</Project>
