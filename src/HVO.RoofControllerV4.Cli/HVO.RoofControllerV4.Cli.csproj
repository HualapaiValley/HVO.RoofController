<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hvo-roof</AssemblyName>
    <RootNamespace>HVO.RoofControllerV4.Cli</RootNamespace>
    <Description>Command-line client and terminal interface for the HVO roof controller, over its REST API and status hub.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- dotnet publish -r linux-arm64 (the Pi) or -r linux-x64 (development) gives one self-contained file. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Terminal.Gui" />
    <ProjectReference Include="../HVO.RoofControllerV4.Client/HVO.RoofControllerV4.Client.csproj" />
    <InternalsVisibleTo Include="HVO.RoofControllerV4.RPi.Tests" />
  </ItemGroup>

</Project>
