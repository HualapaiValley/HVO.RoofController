{
  "RoofControllerOptionsV4": {
    "SafetyWatchdogTimeout": "00:02:30",
    "UseNormallyClosedLimitSwitches": true,
    "IgnorePhysicalLimitSwitches": false
  },

  "RoofControllerHostOptionsV4": {
    "RestartOnFailureWaitTime": 10
  },

  "HardwareDetection": {
    "ForceRaspberryPi": null,
    "ContainerRpiHint": null,
    "UseRealGpio": null
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HVO.RoofControllerV4.RPi.Components.Pages.RoofControlV2": "Information"
    }
  },

  "Telemetry": {
    "ServiceName": "hvo-roof-controller",
    "ActivitySources": [ "HVO.Enterprise.Telemetry", "HVO.RoofController.RPi" ]
  },

  "AllowedHosts": "*"
}