{
  // Development runs against the HAT emulator (HVO.RoofControllerV4.Emulator: an emulated roof, SMVector drive, ME-8108
  // limit switches and SM-I-010 HAT). Start it first, from src/:
  //   dotnet run --project HVO.RoofControllerV4.Emulator
  // The limit switches come from the emulator, so they are in force here, with the documented normally-open wiring as
  // in production. The in-memory register simulation (no roof behind the registers) is kept for unit tests, and as the
  // fallback with emulator mode off and no I2C bus.
  //
  // On physical hardware the controller REFUSES IgnorePhysicalLimitSwitches=true (at startup and on configuration
  // updates) unless AllowIgnoringLimitSwitchesOnPhysicalHardware is also true. Keep that false; set it locally only for
  // supervised bench work with the motor disconnected. It is local-only: the settings API changes it only for a caller
  // with a local credential (the kiosk admin PIN or a local admin API key).
  "RoofControllerOptionsV4": {
    "SafetyWatchdogTimeout": "00:02:00",
    "UseNormallyClosedLimitSwitches": false,
    "IgnorePhysicalLimitSwitches": false,
    "AllowIgnoringLimitSwitchesOnPhysicalHardware": false
  },

  // HAT emulator mode: the HAT's registers are answered by the emulator over TCP. The clients show an EMULATED HAT
  // banner and /health reports Degraded. Outside Development the controller refuses emulator mode unless
  // AllowOutsideDevelopment is set. To use a physical HAT in Development (a commissioned bench), set
  // HatEmulator__Enabled=false, as .devcontainer/devcontainer.rpi.json does.
  "HatEmulator": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 5291
  },

  // The camera is the emulator's MJPEG camera of the emulated roof, on its control port (docs/emulator.md, Camera): with
  // the HAT emulated, a real camera would show a roof that does not move. A bench with a physical HAT sets
  // BlueIris__BaseUrl (and the credentials) to the Blue Iris server.
  "BlueIris": {
    "BaseUrl": "http://127.0.0.1:5290",
    "UserName": "",
    "Password": ""
  },

  "RoofControllerHostOptionsV4": {
    "RestartOnFailureWaitTime": 10
  },

  "HardwareDetection": {
    "ForceRaspberryPi": null,
    "ContainerRpiHint": null,
    "UseRealGpio": null
  },

  // Plain HTTP is accepted in Development. API keys still come from user-secrets or environment variables
  // (docs/security.md), never from this file.
  "RoofControllerSecurity": {
    "RequireHttps": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
