{
  // Development settings are simulation-friendly: limit switches are ignored so the console can be exercised without
  // wiring. On physical hardware the controller REFUSES IgnorePhysicalLimitSwitches=true (at startup and on
  // configuration updates) unless AllowIgnoringLimitSwitchesOnPhysicalHardware is also true. Keep that false; set it
  // locally only for supervised bench work with the motor disconnected. It cannot be changed through the API.
  "RoofControllerOptionsV4": {
    "SafetyWatchdogTimeout": "00:02:00",
    "UseNormallyClosedLimitSwitches": true,
    "IgnorePhysicalLimitSwitches": true,
    "AllowIgnoringLimitSwitchesOnPhysicalHardware": false
  },

  "RoofControllerHostOptionsV4": {
    "RestartOnFailureWaitTime": 10
  },

  "HardwareDetection": {
    "ForceRaspberryPi": null,
    "ContainerRpiHint": null,
    "UseRealGpio": null
  },

  // Plain HTTP is accepted in Development. API keys still come from user-secrets or environment variables
  // (docs/security.md), never from this file.
  "RoofControllerSecurity": {
    "RequireHttps": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HVO.RoofControllerV4.RPi.Components.Pages.RoofControlV2": "Information"
    }
  },

  "AllowedHosts": "*"
}
