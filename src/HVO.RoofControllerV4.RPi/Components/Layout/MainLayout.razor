@using System.Security.Claims
@namespace HVO.RoofControllerV4.RPi.Components.Layout
@inherits LayoutComponentBase

<div class="app-frame">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3 shadow-sm app-navbar">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-house-fill me-2" aria-hidden="true"></i>Roof Controller v4
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" href="/roof-control">
                                <i class="bi bi-house-door" aria-hidden="true"></i> Home
                            </a>
                        </li>
                        <AuthorizeView>
                            <Authorized>
                                <li class="nav-item app-user" data-testid="signed-in-user">
                                    <span class="navbar-text">
                                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                                        @GetDisplayName(context.User)
                                        <span class="badge text-bg-secondary ms-1">@GetRoleLabel(context.User)</span>
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <form method="post" action="@RoofControllerSecurityDefaults.LogoutPostPath" class="app-signout">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-sm btn-outline-light">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out
                                        </button>
                                    </form>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-light" href="@RoofControllerSecurityDefaults.LoginPath">
                                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in
                                    </a>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main container-fluid">
        <div class="row">
            <div class="col-12">
                @Body
            </div>
        </div>
    </main>

    <MainLayoutFooter @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</div>

@code {
    private static string GetDisplayName(ClaimsPrincipal user)
        => string.IsNullOrWhiteSpace(user.Identity?.Name) ? "Signed in" : user.Identity!.Name!;

    private static string GetRoleLabel(ClaimsPrincipal user)
    {
        if (user.IsInRole(RoofControllerApiContract.AdminRole))
        {
            return "Admin";
        }

        if (user.IsInRole(RoofControllerApiContract.OperatorRole))
        {
            return "Operator";
        }

        return user.IsInRole(RoofControllerApiContract.ViewerRole) ? "Viewer" : "No role";
    }
}
