@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(BuildLoginUrl(Navigation), forceLoad: true);
    }

    internal static string BuildLoginUrl(NavigationManager navigation)
    {
        var returnUrl = "/" + navigation.ToBaseRelativePath(navigation.Uri);
        return $"{RoofControllerSecurityDefaults.LoginPath.TrimStart('/')}?{RoofControllerSecurityDefaults.ReturnUrlFormField}={Uri.EscapeDataString(returnUrl)}";
    }
}
