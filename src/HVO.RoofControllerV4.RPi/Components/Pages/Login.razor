@page "/login"
@layout HVO.RoofControllerV4.RPi.Components.Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in - HVO Roof Controller</PageTitle>

<div class="login-card">
    <h1 class="login-title">
        <i class="bi bi-shield-lock" aria-hidden="true"></i> Roof Controller
    </h1>
    <p class="login-subtitle">Enter your access key to continue.</p>

    @if (HasError)
    {
        <div class="alert alert-danger" role="alert" data-testid="login-error">
            The access key was not accepted. Check it and try again.
        </div>
    }

    <form method="post" action="@RoofControllerSecurityDefaults.LoginPostPath">
        <AntiforgeryToken />
        <input type="hidden" name="@RoofControllerSecurityDefaults.ReturnUrlFormField" value="@SafeReturnUrl" />

        <div class="mb-3">
            <label for="login-access-key" class="form-label">Access key</label>
            <input id="login-access-key"
                   name="@RoofControllerSecurityDefaults.AccessKeyFormField"
                   type="password"
                   class="form-control form-control-lg"
                   autocomplete="current-password"
                   required
                   autofocus />
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in
        </button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = RoofControllerSecurityDefaults.ReturnUrlFormField)]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasError => !string.IsNullOrWhiteSpace(Error);

    private string SafeReturnUrl => SanitizeReturnUrl(ReturnUrl);

    /// <summary>
    /// Only local, rooted paths are allowed back through the login form; anything else (absolute URLs,
    /// protocol-relative "//host" or "/\host" forms, control characters, or the login page itself) becomes "/".
    /// </summary>
    internal static string SanitizeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || returnUrl[0] != '/'
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || returnUrl.StartsWith("/\\", StringComparison.Ordinal)
            || returnUrl.Any(char.IsControl)
            || returnUrl.StartsWith(RoofControllerSecurityDefaults.LoginPath, StringComparison.OrdinalIgnoreCase))
        {
            return "/";
        }

        return returnUrl;
    }
}
