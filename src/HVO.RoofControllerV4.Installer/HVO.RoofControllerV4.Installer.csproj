<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hvo-roof-install</AssemblyName>
    <RootNamespace>HVO.RoofControllerV4.Installer</RootNamespace>
    <Description>The roof controller's installer: sets up the controller, a test rig, the kiosk, hvo-roof and the Mac app, and records what it installed.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-arm64;linux-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    dotnet publish -r linux-arm64 (the Pi), -r linux-x64 (a PC test rig) or -r osx-arm64 (a Mac) gives one
    self-contained file, which install.sh downloads and runs.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Terminal.Gui" />
    <ProjectReference Include="../HVO.RoofControllerV4.Client/HVO.RoofControllerV4.Client.csproj" />
    <ProjectReference Include="../HVO.RoofControllerV4.TerminalUi/HVO.RoofControllerV4.TerminalUi.csproj" />
    <InternalsVisibleTo Include="HVO.RoofControllerV4.RPi.Tests" />
    <Using Include="HVO.RoofControllerV4.TerminalUi" />
  </ItemGroup>

  <!-- The deploy script, carried whole: the installer deploys the controller through it, with its checks and verified Stop. -->
  <ItemGroup>
    <EmbeddedResource Include="../HVO.RoofControllerV4.RPi/deploy-roofcontroller-rpi.sh" Link="Deployment/deploy-roofcontroller-rpi.sh" LogicalName="deploy-roofcontroller-rpi.sh" />
  </ItemGroup>

  <!-- It installs on Linux and macOS only: file modes, systemd and Docker are its whole job. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.UnsupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
