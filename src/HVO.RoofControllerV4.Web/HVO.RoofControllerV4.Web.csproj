<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HVO.RoofControllerV4.Web</RootNamespace>
    <Description>The roof controller's web UI (Blazor Server): a separate process in the controller's container, a client of its REST API and status hub.</Description>
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    No appsettings.json: the settings are the RoofWeb section, from the environment (the container's supervisor passes
    the RoofWeb__* variables), with the defaults in RoofWebOptions. A settings file here would also be copied next to
    the controller's in the test project's output.
  -->

  <ItemGroup>
    <ProjectReference Include="../HVO.RoofControllerV4.Client/HVO.RoofControllerV4.Client.csproj" />
    <ProjectReference Include="../HVO.WebSite.Themes/HVO.WebSite.Themes.csproj" />
    <InternalsVisibleTo Include="HVO.RoofControllerV4.RPi.Tests" />
  </ItemGroup>

</Project>
