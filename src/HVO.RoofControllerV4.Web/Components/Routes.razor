<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <Authorizing>
                <p class="web-muted" role="status">Checking your sign-in…</p>
            </Authorizing>
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <RoleDenied />
                }
                else
                {
                    <RedirectToSignIn />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Not found · HVO Roof Controller</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <h1>Not found</h1>
            <p role="alert">There is nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
