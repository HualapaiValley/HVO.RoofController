@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject RoofWebStatusProbe Probe
@inject IOptions<RoofWebOptions> Options
@inject TimeProvider Time
@inject ILogger<Home> Logger

<PageTitle>Roof controller</PageTitle>

<h1>Roof controller</h1>

@if (_status is null)
{
    <p class="web-status web-status--busy" role="status">Checking the controller…</p>
}
else
{
    var view = RoofWebStatusText.DescribeController(_status);
    <section class="web-status web-status--@view.Level.ToString().ToLowerInvariant()" role="status" aria-live="polite"
             data-testid="controller-status" data-level="@view.Level">
        <h2>@view.Headline</h2>
        @foreach (var detail in view.Details)
        {
            <p>@detail</p>
        }
    </section>

    <section class="web-supervisor" data-testid="supervisor-status">
        <h2>Container</h2>
        <p>@RoofWebStatusText.DescribeSupervisor(_status.Supervisor)</p>
    </section>

    <p class="web-checked">Checked at @_status.CheckedAt.UtcDateTime.ToString("HH:mm:ss", CultureInfo.InvariantCulture) UTC, every @Options.Value.StatusRefreshSeconds s.</p>
}

<aside class="web-notice">
    This page reports the controller process and its readiness, not the roof. It does not operate the roof: use the
    controller's console for that, and keep the independent hardware stop within reach.
</aside>

@code {
    private readonly CancellationTokenSource _stopping = new();
    private RoofWebStatus? _status;

    protected override async Task OnInitializedAsync()
    {
        _status = await Probe.CheckAsync(_stopping.Token);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = RefreshAsync(_stopping.Token);
        }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Options.Value.StatusRefreshSeconds), Time);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _status = await Probe.CheckAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            // The page stops refreshing rather than breaking the circuit; a reload starts it again.
            Logger.LogWarning(ex, "The status page stopped refreshing");
        }
    }

    public ValueTask DisposeAsync()
    {
        _stopping.Cancel();
        _stopping.Dispose();
        return ValueTask.CompletedTask;
    }
}
