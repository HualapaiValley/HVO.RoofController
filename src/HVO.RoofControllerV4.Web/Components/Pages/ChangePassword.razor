@page "/account/password"
@using HVO.RoofControllerV4.Common.Models
@inject WebSessionAccessor Sessions
@inject ILogger<ChangePassword> Logger

<PageTitle>Change password · HVO Roof Controller</PageTitle>

<h1>Change your password</h1>

<div class="web-card web-narrow">
    <p class="web-muted">
        @PasswordRule Changing it ends your other sessions (on other computers, in the command line and in other browsers);
        this one stays signed in.
    </p>

    @if (_message is not null)
    {
        <div class="alert @(_succeeded ? "alert-success" : "alert-danger")" role="@(_succeeded ? "status" : "alert")" data-testid="password-message">
            @_message
        </div>
    }

    <EditForm FormName="change-password" Model="_form" OnSubmit="ChangeAsync">
        <div class="mb-3">
            <label for="password-current" class="form-label">Current password</label>
            <InputText id="password-current" type="password" class="form-control" autocomplete="current-password" @bind-Value="_form.Current" />
        </div>
        <div class="mb-3">
            <label for="password-new" class="form-label">New password</label>
            <InputText id="password-new" type="password" class="form-control" autocomplete="new-password" @bind-Value="_form.New" />
        </div>
        <div class="mb-3">
            <label for="password-again" class="form-label">New password again</label>
            <InputText id="password-again" type="password" class="form-control" autocomplete="new-password" @bind-Value="_form.Again" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@_busy" data-testid="change-password">
            <i class="bi bi-key" aria-hidden="true"></i> Change password
        </button>
    </EditForm>
</div>

@code {
    internal static readonly string PasswordRule = string.Create(
        CultureInfo.InvariantCulture,
        $"A password has {RoofIdentityContract.MinimumPasswordLength} to {RoofIdentityContract.MaximumPasswordLength} characters.");

    private readonly PasswordForm _form = new();
    private string? _message;
    private bool _succeeded;
    private bool _busy;

    private async Task ChangeAsync()
    {
        _succeeded = false;
        if (string.IsNullOrEmpty(_form.Current))
        {
            _message = "Enter your current password.";
            return;
        }

        if (!RoofIdentityContract.IsValidPassword(_form.New))
        {
            _message = PasswordRule;
            return;
        }

        if (!string.Equals(_form.New, _form.Again, StringComparison.Ordinal))
        {
            _message = "The two new passwords are not the same.";
            return;
        }

        var session = await Sessions.GetAsync();
        if (session is null)
        {
            _message = "Your session ended. Sign in again, then change your password.";
            return;
        }

        _busy = true;
        try
        {
            await session.Client.Auth.ChangePasswordAsync(_form.Current, _form.New!);
            _succeeded = true;
            _message = "Your password was changed. Your other sessions were ended.";
            Logger.LogInformation("{Name} changed their password in the web UI", session.Name);
        }
        catch (RoofApiException ex) when (ex.Code == RoofControllerErrorCode.SignInFailed)
        {
            _message = "The current password is not correct. The password was not changed.";
        }
        catch (Exception ex) when (ex is RoofApiException or TimeoutException or HttpRequestException or RoofProtocolException)
        {
            _message = $"The password was not changed. {RoofText.DescribeFailure(ex)}";
        }
        finally
        {
            _busy = false;
            _form.Current = _form.New = _form.Again = null;
        }
    }

    private sealed class PasswordForm
    {
        public string? Current { get; set; }

        public string? New { get; set; }

        public string? Again { get; set; }
    }
}
