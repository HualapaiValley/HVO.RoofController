<div class="camera-stream" data-testid="camera" data-camera="@CameraId">
    <div @ref="_container" class="player-frame @(IsLive ? string.Empty : "is-stale")" tabindex="0" role="region" aria-label="@Label">
        <canvas @ref="_canvas" class="camera-stream__canvas" width="1280" height="720" aria-hidden="true"></canvas>

        @if (!IsLive)
        {
            <div class="camera-stream__overlay" data-testid="camera-overlay">
                <i class="bi @OverlayIcon" aria-hidden="true"></i>
                <span class="camera-stream__overlay-title">@OverlayTitle</span>
                @if (!string.IsNullOrWhiteSpace(_detail))
                {
                    <span class="camera-stream__overlay-detail">@_detail</span>
                }
            </div>
        }

        <div @ref="_controls" class="controls-bar">
            <button type="button" class="control-btn" @onclick="TogglePlayback" disabled="@(!IsReady)"
                    title="@PlaybackButtonTitle" aria-label="@PlaybackButtonTitle">
                <i class="bi @PlaybackButtonIcon" aria-hidden="true"></i>
            </button>
            <button type="button" class="control-btn" @onclick="Restart" disabled="@(!IsReady)"
                    title="Reconnect stream" aria-label="Reconnect stream">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            </button>
            <button type="button" class="control-btn" @onclick="Snapshot" disabled="@(!IsReady || !HasFrame)"
                    title="Snapshot" aria-label="Snapshot">
                <i class="bi bi-camera-fill" aria-hidden="true"></i>
            </button>
            <button type="button" class="control-btn record-btn @(_recording ? "is-active" : string.Empty)" @onclick="ToggleRecord" disabled="@(!IsReady)"
                    title="@RecordButtonTitle" aria-label="@RecordButtonTitle">
                <i class="bi @RecordButtonIcon" aria-hidden="true"></i>
            </button>
            <button type="button" class="control-btn" @onclick="Fullscreen" disabled="@(!IsReady)"
                    title="Fullscreen" aria-label="Fullscreen">
                <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
            </button>

            <span class="status-chip @StatusChipClass" role="status" data-testid="camera-status">@StatusText</span>
        </div>
    </div>

    <a @ref="_downloadLink" class="download-link" style="display:none;" download>Download</a>
</div>
