<header class="web-page-heading">
    <div>
        <p class="web-eyebrow">Hualapai Valley Observatory</p>
        <h1>@Title</h1>
        <p class="web-page-description">@Description</p>
    </div>
    @if (Actions is not null)
    {
        <div class="web-actions">@Actions</div>
    }
</header>

@code {
    /// <summary>The route's main title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    /// <summary>A short explanation of the workflow.</summary>
    [Parameter, EditorRequired] public string Description { get; set; } = default!;
    /// <summary>Optional page-level actions.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
