<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:HVO.RoofControllerV4.iPad.ViewModels"
             x:Class="HVO.RoofControllerV4.iPad.CameraPage"
             x:DataType="viewModels:RoofControllerViewModel"
             BackgroundColor="#10131A">

    <Grid Padding="32"
          RowSpacing="24"
          RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="16">
            <Label Text="Roof Camera"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#F8F9FA" />
            <Label Text="Camera view of the observatory roof. The app can tell whether the stream loaded, but not whether it later froze: check the timestamp in the image, or the roof itself, before relying on it."
                   TextColor="#CED4DA"
                   FontSize="16"
                   LineHeight="1.35" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                BackgroundColor="#1B1F27"
                StrokeThickness="0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*">
                <Grid Padding="20"
                      ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="16"
                      BackgroundColor="#222630">
                    <Label Grid.Column="0"
                           Text="Roof Camera"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#F8F9FA"
                           VerticalOptions="Center" />
                    <Label x:Name="CameraStatusLabel"
                           Grid.Column="1"
                           Text="Not loaded"
                           TextColor="#ADB5BD"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="Reload"
                            Clicked="OnReloadClicked"
                            BackgroundColor="#495057"
                            TextColor="White"
                            CornerRadius="12"
                            Padding="16,8" />
                </Grid>
                <Grid Grid.Row="1" BackgroundColor="#13161F">
                    <WebView x:Name="CameraView"
                             IsVisible="False"
                             Navigating="OnCameraNavigating"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill" />
                    <VerticalStackLayout x:Name="CameraPlaceholder"
                                         Spacing="8"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="20">
                        <Label x:Name="CameraPlaceholderTitle"
                               Text="Camera not loaded"
                               TextColor="#ADB5BD"
                               FontSize="17"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="CameraPlaceholderDetail"
                               Text="Set the camera stream URL on the Configuration tab to enable the feed."
                               TextColor="#6C757D"
                               FontSize="14"
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
