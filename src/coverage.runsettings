<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>cobertura</Format>
					<!-- Coverlet filters are [assembly]type; instrument only this repo's product assemblies,
					     not HVO.* NuGet dependencies (HVO.Core, HVO.Iot.Devices, HVO.Enterprise.*). -->
					<Include>[HVO.RoofControllerV4.*]*,[HVO.WebSite.Themes]*</Include>
					<!-- Exclude all test assemblies and generated test hosts -->
					<Exclude>[*.Tests]*</Exclude>
					<SkipAutoProps>true</SkipAutoProps>
					<UseSourceLink>true</UseSourceLink>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>
