#!/usr/bin/env bash
# A stand-in for curl, for the health check tests in supervisor-tests.sh. It answers with the HTTP status in
# FAKE_DIR/curl-<port>.code (000, a failed connection, when there is none) and records its arguments in curl.log.
set -uo pipefail
url=""
for arg in "$@"; do
  [[ "${arg}" == http://* || "${arg}" == https://* ]] && url=${arg}
done
printf '%s\n' "$*" >>"${FAKE_DIR}/curl.log"
address=${url#*://}
address=${address%%/*}
port=${address##*:}
code=$(cat "${FAKE_DIR}/curl-${port}.code" 2>/dev/null || echo 000)
printf '%s' "${code}"
[[ "${code}" != 000 ]] || exit 7
