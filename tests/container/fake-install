#!/usr/bin/env bash
# A stand-in for install, for the supervisor tests of the web UI's default keys directory, /var/lib/hvo-roof-web/keys,
# which only root can make: it appends its arguments to FAKE_DIR/install.log (one call a line) and makes nothing under
# /var/lib/hvo-roof-web. Every other call goes to the real install, found on PATH without this stand-in's directory.
# With FAKE_DIR/install.delay, a call that makes a keys directory (its last argument ends in /keys) first takes that many
# seconds, as on a slow or hung filesystem: it writes its pid to install.pid, and "install keys <pid>" and then
# "install keys done" to events.log (and, with times, to times.log).
set -uo pipefail

printf '%s\n' "$*" >>"${FAKE_DIR}/install.log"
if [[ -f "${FAKE_DIR}/install.delay" && "${*: -1}" == */keys ]]; then
  printf '%s\n' "$$" >"${FAKE_DIR}/install.pid"
  printf '%s install keys %s\n' "${EPOCHREALTIME}" "$$" >>"${FAKE_DIR}/times.log"
  printf 'install keys %s\n' "$$" >>"${FAKE_DIR}/events.log"
  sleep "$(<"${FAKE_DIR}/install.delay")"
  printf '%s install keys done\n' "${EPOCHREALTIME}" >>"${FAKE_DIR}/times.log"
  printf 'install keys done\n' >>"${FAKE_DIR}/events.log"
fi
case "${*: -1}" in
  /var/lib/hvo-roof-web | /var/lib/hvo-roof-web/*) exit 0 ;;
esac
PATH=${PATH//"$(dirname "$0"):"/}
exec install "$@"
