<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1030</NoWarn>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!--
      The tests have no static web assets of their own. The web UI's host reads the web UI's own manifest, copied here
      with it.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Avalonia's build statistics (Avalonia.BuildServices) are not sent: nothing is reported from a build of this repository. -->
    <UsedAvaloniaProducts />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="bunit" />
    <PackageReference Include="FluentAssertions" />
  <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Cli\HVO.RoofControllerV4.Cli.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Installer\HVO.RoofControllerV4.Installer.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Client\HVO.RoofControllerV4.Client.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Kiosk\HVO.RoofControllerV4.Kiosk.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Mac\HVO.RoofControllerV4.Mac.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.RPi\HVO.RoofControllerV4.RPi.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Screens\HVO.RoofControllerV4.Screens.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Simulation\HVO.RoofControllerV4.Simulation.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Emulator\HVO.RoofControllerV4.Emulator.csproj" />
    <ProjectReference Include="..\..\src\HVO.RoofControllerV4.Web\HVO.RoofControllerV4.Web.csproj" />
    <PackageReference Include="HVO.Iot.Devices" />
  </ItemGroup>

</Project>
