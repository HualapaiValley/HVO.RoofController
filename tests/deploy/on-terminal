#!/usr/bin/env python3
"""Runs a command on its own pseudo-terminal, as a deploy from an SSH session or a terminal window would run.

Usage: on-terminal <pid-file> <log-file> <command> [args...]

The command becomes a session leader with the terminal as its controlling terminal (stdout and stderr; stdin is
/dev/null). A separate reader process, whose PID is written to <pid-file>, copies the terminal output to <log-file>.
Killing the reader closes the terminal, as closing the window or losing the SSH connection does: the kernel hangs the
terminal up, sends SIGHUP to the command, and its later writes to the terminal fail with EIO. Exits with the command's
status (128 + N when a signal ended it).

With ON_TERMINAL_PROMPT and ON_TERMINAL_ANSWER set, the reader types the answer (and Enter) once the prompt text has
appeared on the terminal, as an operator at the keyboard would. The command reads it from /dev/tty.
"""
import os
import sys


def main():
    pid_file, log_file, command = sys.argv[1], sys.argv[2], sys.argv[3:]
    master, slave = os.openpty()

    reader = os.fork()
    if reader == 0:
        os.close(slave)
        with open(pid_file, "w") as f:
            f.write(str(os.getpid()))
        prompt = os.environ.get("ON_TERMINAL_PROMPT", "").encode()
        answer = os.environ.get("ON_TERMINAL_ANSWER")
        seen = b""
        with open(log_file, "wb") as log:
            while True:
                try:
                    data = os.read(master, 4096)
                except OSError:
                    break
                if not data:
                    break
                log.write(data)
                log.flush()
                if prompt and answer is not None:
                    seen += data
                    if prompt in seen:
                        os.write(master, answer.encode() + b"\n")
                        answer = None
        os._exit(0)
    os.close(master)

    child = os.fork()
    if child == 0:
        os.setsid()
        import fcntl
        import termios
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(slave, 1)
        os.dup2(slave, 2)
        os.close(slave)
        os.close(null)
        os.execvp(command[0], command)
    os.close(slave)

    _, status = os.waitpid(child, 0)
    os.waitpid(reader, 0)
    sys.exit(128 + os.WTERMSIG(status) if os.WIFSIGNALED(status) else os.WEXITSTATUS(status))


main()
