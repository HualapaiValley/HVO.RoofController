#!/usr/bin/env python3
"""Fake `curl` for deploy-script-tests.sh: the remote check from the deploying machine.

Appends argv (as JSON) to $FAKE_STATE_DIR/remote.log. The request reaches the running container that publishes the
URL's port (from state.json); HTTPS must hit container port 8443 and HTTP container port 8080, otherwise the call fails
as curl would. The key (FAKE_EXPECTED_KEY) must arrive on stdin (-H @-), otherwise the call gets 401.
FAKE_REMOTE_STATUS_CODE overrides the Status response code, FAKE_REMOTE_STOP=unverified the Stop result, and
FAKE_REQUIRE_CACERT=true fails HTTPS without --cacert. --connect-to HOST1:PORT1:HOST2:PORT2 reaches HOST2 (and PORT2) for
HOST1 (and PORT1), as curl does; FAKE_CERT_NAMES (comma-separated) fails HTTPS to a name the certificate does not have. The Status and the Stop report the container's hatMode as the fake
docker does (FAKE_<KIND>_HAT_MODE, otherwise from its HatEmulator__Enabled setting, and FAKE_<KIND>_PHYSICAL).
The web UI's /health/live must hit container port 8088 with the scheme of the container's RoofWeb__Urls (the image's
default is http); it needs no key, and FAKE_REMOTE_WEB_LIVE=false fails it (HTTP 503).
"""
import json
import os
import sys
from urllib.parse import urlparse

STATE_DIR = os.environ["FAKE_STATE_DIR"]
VERIFIED = {"relayRegisterState": "Verified", "relayRegisterMask": 0, "commandedMotion": "None"}
UNVERIFIED = {"relayRegisterState": "Unknown", "relayRegisterMask": None, "commandedMotion": "None"}


def fail(code, message):
    print(f"curl: ({code}) {message}", file=sys.stderr)
    sys.exit(code)


def with_hat_mode(c, body):
    mode = os.environ.get(f"FAKE_{c['kind'].upper()}_HAT_MODE", "")
    if not mode:
        enabled = [o for o in c.get("options", []) if o.startswith("HatEmulator__Enabled=")]
        mode = "Emulated" if enabled and enabled[-1] == "HatEmulator__Enabled=true" else "Physical"
    physical = os.environ.get(f"FAKE_{c['kind'].upper()}_PHYSICAL", "false" if mode == "Simulation" else "true")
    body = dict(body, isUsingPhysicalHardware=physical == "true")
    return body if mode == "absent" else dict(body, hatMode=mode)


def main():
    args = sys.argv[1:]
    with open(os.path.join(STATE_DIR, "remote.log"), "a") as log:
        log.write(json.dumps(args) + "\n")

    url = urlparse(args[-1])
    host, port = url.hostname, url.port
    if "--connect-to" in args:
        from_host, from_port, to_host, to_port = args[args.index("--connect-to") + 1].split(":")
        if from_host in ("", host) and from_port in ("", str(port)):
            host, port = to_host or host, int(to_port) if to_port else port
    names = os.environ.get("FAKE_CERT_NAMES", "")
    if url.scheme == "https" and names and url.hostname not in names.split(","):
        fail(60, f"SSL: no alternative certificate subject name matches target host name '{url.hostname}'")
    method = args[args.index("-X") + 1] if "-X" in args else "GET"
    stdin_text = sys.stdin.read() if "@-" in args else ""

    with open(os.path.join(STATE_DIR, "state.json")) as f:
        containers = json.load(f)["containers"]

    target = container = None
    for c in containers.values():
        for mapping in c.get("publish", []) if c["running"] else []:
            # [<address>:]<host port>:<container port>: a port published on an address answers only there.
            *address, host_port, container_port = mapping.split(":")
            if address and host not in (address[0], "localhost"):
                continue
            if int(host_port) == port:
                target, container = int(container_port), c
    if target is None:
        fail(7, f"Failed to connect to {host} port {port}: Connection refused")
    if url.path.endswith("/health/live"):
        web_urls = [o for o in container.get("options", []) if o.startswith("RoofWeb__Urls=")]
        scheme = (web_urls[-1].split("=", 1)[1] if web_urls else "http://+:8088").split("://")[0]
        if target != 8088:
            fail(22, "The requested URL returned error: 404")
        if url.scheme != scheme:
            fail(35 if url.scheme == "https" else 52, f"{url.scheme} to a web UI serving {scheme}")
        if url.scheme == "https" and os.environ.get("FAKE_REQUIRE_CACERT") == "true" and "--cacert" not in args:
            fail(60, "SSL certificate problem: self-signed certificate")
        if os.environ.get("FAKE_REMOTE_WEB_LIVE") == "false":
            fail(22, "The requested URL returned error: 503")
        return
    if url.scheme == "https" and target != 8443:
        fail(35, "OpenSSL: error:0A00010B:SSL routines::wrong version number")
    if url.scheme == "https" and os.environ.get("FAKE_REQUIRE_CACERT") == "true" and "--cacert" not in args:
        fail(60, "SSL certificate problem: self-signed certificate")
    if url.scheme == "http" and target == 8443:
        fail(52, "Empty reply from server")

    if stdin_text.strip() != f"X-Api-Key: {os.environ['FAKE_EXPECTED_KEY']}":
        print('{"error":"unauthorized"}\n401', end="")
        return

    if url.path.endswith("/Status") and method == "GET":
        print(json.dumps(with_hat_mode(container, VERIFIED)) + "\n" + os.environ.get("FAKE_REMOTE_STATUS_CODE", "200"), end="")
    elif url.path.endswith("/Stop") and method == "POST":
        body = UNVERIFIED if os.environ.get("FAKE_REMOTE_STOP") == "unverified" else VERIFIED
        print(json.dumps(with_hat_mode(container, body)) + "\n200", end="")
    else:
        print("{}\n404", end="")


main()
