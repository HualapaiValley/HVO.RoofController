#!/usr/bin/env python3
"""Fake `docker` CLI for deploy-script-tests.sh.

Keeps containers in $FAKE_STATE_DIR/state.json (keyed by name, each with a 64-hex "id") and appends every call's argv
(as JSON) to $FAKE_STATE_DIR/calls.log. Commands take a container name or an ID prefix, as docker does. A container's
docker state is "running" or "exited" from its "running" flag, or its optional "state" (paused, restarting, created);
stop and start clear "state". `ps` supports -a, --no-trunc, --filter name=<regex>|id=<prefix> and Go-style --format
({{.Label "<key>"}} reads the container's optional "labels", as a Compose-created container has).
`inspect` supports two --format templates: '{{range .Config.Env}}{{println .}}{{end}}', the --env/-e values the
container was run with (its "options"), and '{{.State.Status}} {{.RestartCount}}', its docker state and optional
"restart_count". Starting a stopped container resets the count to 0, as docker start does; starting a running or
restarting one changes nothing, and starting a paused one fails.
Container behaviour is chosen per container "kind" (old, current, new, ...) with environment variables:
  FAKE_<KIND>_READY=false          /health/ready fails
  FAKE_<KIND>_STATUS_CODE=<code>   HTTP status of the in-container GET Status (default 200)
  FAKE_<KIND>_STOP=unverified      the in-container POST Stop is not verified (error: the exec fails)
  FAKE_<KIND>_HAT_MODE=<mode>      hatMode of the in-container Status and Stop (absent: no hatMode, as before emulator
                                   mode). By default Emulated when the container was run with HatEmulator__Enabled=true
                                   (the last one given), otherwise Physical.
  FAKE_<KIND>_PHYSICAL=true|false  isUsingPhysicalHardware of the same responses (default false for hatMode Simulation,
                                   otherwise true)
  FAKE_<KIND>_WEB_LIVE=false       the web UI's /health/live fails inside the container
  FAKE_<KIND>_SUPERVISOR=<view>    what `exec <c> cat /run/hvo-roof/supervisor.json` finds (by default both processes
                                   running, each started once): absent (no such file, as in an image from before the
                                   supervisor), restarting (the controller waits to start again), crash-loop (the
                                   controller is left stopped), restarted (each read finds the controller started once
                                   more), ui-restarting, or ui-restarted (the same for the web UI)
Other switches:
  FAKE_PREFLIGHT_EXIT=<code>       exit code of `run --rm ... --validate-deployment`
  FAKE_RUN_FAIL=true               `run -d` fails before creating the container
  FAKE_RUN_FAIL=created            `run -d` creates the container (state created, ID in the --cidfile), then fails
  FAKE_RUN_FAIL=foreign            another client's running container (kind foreign) takes the name; `run -d` fails
  FAKE_NEW_EXITS=restarted|restarting|exited
                                   `run -d` succeeds, but the controller it starts exits at once (it passed the
                                   pre-flight, then failed on its normal start). With --restart unless-stopped Docker
                                   restarts it: restarted is running again, and each inspect finds it restarted once
                                   more (a crash loop); restarting is waiting to restart; exited is stopped, as when
                                   Docker cannot start it again (a device has gone).
  FAKE_STOP_FAIL=true              `stop` fails
  FAKE_STOP_CUT_OFF=true           the first `stop` loses its connection: the client fails and the daemon finishes the
                                   stop by itself FAKE_ASYNC_STOP_SECONDS (default 1) later
  FAKE_FAIL="<text>[@N];..."       a call whose argv (space-joined, without --context) contains <text> fails; with @N
                                   only the N-th such call
  FAKE_SIGNAL_ON=<text>[;<text>]   the first call containing <text> sends FAKE_SIGNAL (default TERM) to the script
                                   (pid in script.pid), then runs normally; with FAKE_SIGNAL_KILLS_OUTPUT=true it first
                                   kills the process reading the script's output (pid in output.pid). Each further
                                   <text> is armed once the one before it has fired.
  FAKE_CONTEXT_PROMPTS=true        the context asks for a password (an ssh:// context without a key): a call in its own
                                   session, with no terminal to prompt on, fails; any other call succeeds, as if the
                                   password had been typed
  FAKE_SIGNAL_GROUP=true           the signal goes to the script's process group, as a Ctrl-C at the terminal does: a
                                   call in that group is cut short, as Docker CLI 27+ is on SIGINT even when the signal
                                   is ignored. The daemon still finishes a `stop` FAKE_ASYNC_STOP_SECONDS later; any
                                   other request is dropped. A call in its own session is not reached.
A container whose stop the daemon is still finishing stays running until then; `start` does nothing to it and `stop`
waits for it.
Containers created by `run -d` have kind "new". Authenticated calls must send FAKE_EXPECTED_KEY on stdin (-H @-),
otherwise they get 401. Output errors (closed or broken stdout/stderr) are ignored, as they would not change Docker.
"""
import json
import os
import re
import secrets
import signal
import sys
import time

STATE_DIR = os.environ["FAKE_STATE_DIR"]
STATE_FILE = os.path.join(STATE_DIR, "state.json")
VERIFIED = {"relayRegisterState": "Verified", "relayRegisterMask": 0, "commandedMotion": "None"}
UNVERIFIED = {"relayRegisterState": "Unknown", "relayRegisterMask": None, "commandedMotion": "None"}


def out(text="", end="\n"):
    try:
        if sys.stdout is not None:
            sys.stdout.write(text + end)
    except (OSError, ValueError):
        pass


def err(text):
    try:
        if sys.stderr is not None:
            sys.stderr.write(text + "\n")
            sys.stderr.flush()
    except (OSError, ValueError):
        pass


def die(message, code=1):
    err(f"Error response from daemon: {message}")
    sys.exit(code)


def load():
    try:
        with open(STATE_FILE) as f:
            state = json.load(f)
    except FileNotFoundError:
        state = {"containers": {}}
    changed = False
    for c in state["containers"].values():
        if not c.get("id"):
            c["id"] = secrets.token_hex(32)
            changed = True
        if c.get("stopping_until") is not None and c["stopping_until"] <= time.time():
            finish_stop(c)
            changed = True
    if changed:
        save(state)
    return state


def save(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def finish_stop(c):
    c.pop("stopping_until", None)
    c["running"] = False
    c.pop("state", None)


def stop_in_background(state, ref):
    """The daemon goes on stopping the container after its client has gone."""
    _, c = container(state, ref)
    if c["running"] and c.get("stopping_until") is None:
        c["stopping_until"] = time.time() + float(os.environ.get("FAKE_ASYNC_STOP_SECONDS", "1"))
        save(state)


def behaviour(kind, name, default):
    return os.environ.get(f"FAKE_{kind.upper()}_{name}", default)


def with_hat_mode(c, body):
    mode = behaviour(c["kind"], "HAT_MODE", "")
    if not mode:
        enabled = [o for o in c.get("options", []) if o.startswith("HatEmulator__Enabled=")]
        mode = "Emulated" if enabled and enabled[-1] == "HatEmulator__Enabled=true" else "Physical"
    physical = behaviour(c["kind"], "PHYSICAL", "false" if mode == "Simulation" else "true")
    body = dict(body, isUsingPhysicalHardware=physical == "true")
    return body if mode == "absent" else dict(body, hatMode=mode)


def env_of(c):
    options, env = c.get("options", []), []
    for i, value in enumerate(options):
        if value in ("--env", "-e") and i + 1 < len(options):
            env.append(options[i + 1])
        elif value.startswith("--env="):
            env.append(value[len("--env="):])
    return env


def inspect(state, args):
    fmt, refs, i = None, [], 0
    while i < len(args):
        if args[i] in ("--format", "-f"):
            fmt, i = args[i + 1], i + 2
        else:
            refs.append(args[i])
            i += 1
    if fmt not in ("{{range .Config.Env}}{{println .}}{{end}}", "{{.State.Status}} {{.RestartCount}}"):
        die(f"fake docker: unsupported inspect format: {fmt}")
    for ref in refs:
        _, c = container(state, ref)
        if fmt.startswith("{{.State"):
            if c.get("crash_loop"):
                c["restart_count"] = c.get("restart_count", 0) + 1
                save(state)
            out(f"{docker_state(c)} {c.get('restart_count', 0)}")
        else:
            # println ends each value with a newline, and docker adds one after the template.
            out("".join(f"{e}\n" for e in env_of(c)))


def docker_state(c):
    return c.get("state") or ("running" if c["running"] else "exited")


def resolve(state, ref):
    """(name, container) for a name, a full ID or a unique ID prefix; None when there is no such container."""
    containers = state["containers"]
    if ref in containers:
        return ref, containers[ref]
    matches = [(n, c) for n, c in containers.items() if c["id"].startswith(ref)] if ref else []
    if len(matches) > 1:
        die(f"multiple IDs found with provided prefix: {ref}")
    return matches[0] if matches else None


def container(state, ref):
    found = resolve(state, ref)
    if found is None:
        die(f"No such container: {ref}")
    return found


def new_id():
    return secrets.token_hex(32)


def fail_if_requested(command_line):
    spec = os.environ.get("FAKE_FAIL", "")
    if not spec:
        return
    counts_file = os.path.join(STATE_DIR, "fail-counts.json")
    try:
        with open(counts_file) as f:
            counts = json.load(f)
    except FileNotFoundError:
        counts = {}
    fail = None
    for entry in filter(None, spec.split(";")):
        text, nth = entry, None
        if "@" in entry and entry.rsplit("@", 1)[1].isdigit():
            text, nth = entry.rsplit("@", 1)[0], int(entry.rsplit("@", 1)[1])
        if text in command_line:
            counts[entry] = counts.get(entry, 0) + 1
            if nth is None or counts[entry] == nth:
                fail = text
    with open(counts_file, "w") as f:
        json.dump(counts, f)
    if fail is not None:
        die(f"fake failure ({fail})")


def read_pid(name, wait_seconds=0.0):
    path = os.path.join(STATE_DIR, name)
    deadline = time.monotonic() + wait_seconds
    while True:
        try:
            with open(path) as f:
                return int(f.read().strip())
        except (FileNotFoundError, ValueError):
            if time.monotonic() >= deadline:
                return None
            time.sleep(0.05)


def signal_if_requested(command_line):
    """Sends the next requested signal; True when it also cuts this call short (FAKE_SIGNAL_GROUP)."""
    triggers = [t for t in os.environ.get("FAKE_SIGNAL_ON", "").split(";") if t]
    counter = os.path.join(STATE_DIR, "signals.sent")
    try:
        with open(counter) as f:
            sent = int(f.read().strip() or "0")
    except FileNotFoundError:
        sent = 0
    if sent >= len(triggers) or triggers[sent] not in command_line:
        return False
    with open(counter, "w") as f:
        f.write(str(sent + 1))
    if os.environ.get("FAKE_SIGNAL_KILLS_OUTPUT") == "true" and sent == 0:
        reader = read_pid("output.pid", wait_seconds=5.0)
        if reader is not None:
            try:
                os.kill(reader, signal.SIGKILL)
            except ProcessLookupError:
                pass
            time.sleep(0.2)
    script = read_pid("script.pid")
    if script is None:
        return False
    os.kill(script, getattr(signal, "SIG" + os.environ.get("FAKE_SIGNAL", "TERM")))
    if os.environ.get("FAKE_SIGNAL_GROUP") != "true":
        return False
    try:
        return os.getpgid(script) == os.getpgrp()
    except ProcessLookupError:
        return False


def cut_off_stop_requested():
    if os.environ.get("FAKE_STOP_CUT_OFF") != "true":
        return False
    marker = os.path.join(STATE_DIR, "stop-cut-off")
    if os.path.exists(marker):
        return False
    open(marker, "w").close()
    return True


def supervisor_json(state, c):
    """The container supervisor's state file (roof-supervisor.sh writes this format), as FAKE_<KIND>_SUPERVISOR says."""
    view = behaviour(c["kind"], "SUPERVISOR", "")
    if view == "absent":
        die("cat: /run/hvo-roof/supervisor.json: No such file or directory")
    processes = {"controller": ["running", 1], "ui": ["running", 1]}
    name = "ui" if view.startswith("ui-") else "controller"
    view = view.removeprefix("ui-")
    if view == "restarting":
        processes[name][0] = "restarting"
    elif view == "crash-loop":
        processes[name] = ["crash-loop", 5]
    elif view == "restarted":
        key = f"supervised_{name}_starts"
        c[key] = c.get(key, 1) + 1
        save(state)
        processes[name][1] = c[key]
    parts = []
    for process, (process_state, starts) in processes.items():
        pid = "null" if process_state != "running" else "42"
        parts.append(f'"{process}":{{"state":"{process_state}","pid":{pid},"starts":{starts},"recentCrashes":0,'
                     '"lastExitCode":null,"lastExitReason":null,"lastExitAt":null}')
    out('{"supervisor":"running","updatedAt":"2026-01-01T00:00:00Z","crashLimit":5,"crashWindowSeconds":120,'
        + ",".join(parts) + "}")


def exec_curl(state, ref, curl_args, stdin_text):
    name, c = container(state, ref)
    current = docker_state(c)
    if current == "paused":
        die(f"Container {c['id']} is paused, unpause the container before exec")
    if current == "restarting":
        die(f"Container {c['id']} is restarting, wait until the container is running")
    if not c["running"]:
        die(f"container {name} is not running")
    kind = c["kind"]
    if curl_args == ["cat", "/run/hvo-roof/supervisor.json"]:
        supervisor_json(state, c)
        return
    url = curl_args[-1]
    method = curl_args[curl_args.index("-X") + 1] if "-X" in curl_args else "GET"

    if url.endswith("/health/ready"):
        sys.exit(0 if behaviour(kind, "READY", "true") == "true" else 22)
    if url.endswith("/health/live"):
        sys.exit(0 if behaviour(kind, "WEB_LIVE", "true") == "true" else 22)

    if "@-" in curl_args and stdin_text.strip() != f"X-Api-Key: {os.environ['FAKE_EXPECTED_KEY']}":
        out('{"error":"unauthorized"}\n401', end="")
        return

    if url.endswith("/Status") and method == "GET":
        code = behaviour(kind, "STATUS_CODE", "200")
        out(json.dumps(with_hat_mode(c, VERIFIED)) + "\n" + code, end="")
    elif url.endswith("/Stop") and method == "POST":
        stop = behaviour(kind, "STOP", "verified")
        if stop == "error":
            die("exec failed")
        out(json.dumps(with_hat_mode(c, VERIFIED if stop == "verified" else UNVERIFIED)) + "\n200", end="")
    else:
        out("{}\n404", end="")


def status_text(c):
    return {
        "running": "Up 2 minutes",
        "paused": "Up 2 minutes (Paused)",
        "restarting": "Restarting (1) 3 seconds ago",
        "created": "Created",
    }.get(docker_state(c), "Exited (0) 1 minute ago")


def ps(state, args):
    show_all = no_trunc = False
    filters, fmt = [], None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-a", "--all"):
            show_all = True
        elif a == "--no-trunc":
            no_trunc = True
        elif a == "--filter":
            filters.append(args[i + 1])
            i += 1
        elif a == "--format":
            fmt = args[i + 1]
            i += 1
        else:
            die(f"fake docker: unsupported ps option {a}")
        i += 1

    def matches(name, c):
        if not show_all and not c["running"]:
            return False
        for f in filters:
            key, _, value = f.partition("=")
            if key == "name":
                if not (re.search(value, "/" + name) or re.search(value, name)):
                    return False
            elif key == "id":
                if not c["id"].startswith(value):
                    return False
            else:
                die(f"fake docker: unsupported ps filter {key}")
        return True

    fmt = fmt or "table {{.ID}}\t{{.Names}}\t{{.Status}}"
    table = fmt.startswith("table ")
    if table:
        fmt = fmt[len("table "):]
    fmt = fmt.replace("\\t", "\t")
    headers = {"ID": "CONTAINER ID", "Names": "NAMES", "Status": "STATUS", "Image": "IMAGE", "State": "STATE"}
    if table:
        out(re.sub(r"\{\{\.(\w+)\}\}", lambda m: headers[m.group(1)], fmt))
    for name, c in state["containers"].items():
        if matches(name, c):
            fields = {
                "ID": c["id"] if no_trunc else c["id"][:12],
                "Names": name,
                "Status": status_text(c),
                "Image": c.get("image", os.environ["IMAGE_TAG"]),
                "State": docker_state(c),
            }

            def field(m):
                if m.group(1) == "Label":
                    return c.get("labels", {}).get(m.group(2), "")
                return fields[m.group(1)]

            out(re.sub(r'\{\{\.(\w+)(?: "([^"]*)")?\}\}', field, fmt))


def run(state, args, image):
    position = args.index(image)
    options, trailing = args[:position], args[position + 1:]
    if "--rm" in options:
        out("Deployment check (Production):")
        code = int(os.environ.get("FAKE_PREFLIGHT_EXIT", "0"))
        out("Deployment check passed." if code == 0 else "  PROBLEM: fake problem")
        sys.exit(code)

    name, cidfile, restart, publish = None, None, None, []
    for i, value in enumerate(options):
        following = options[i + 1] if i + 1 < len(options) else None
        if value == "--name":
            name = following
        elif value.startswith("--name="):
            name = value[len("--name="):]
        elif value == "--cidfile":
            cidfile = following
        elif value == "--restart":
            restart = following
        elif value == "-p":
            publish.append(following)
    if name is None:
        die("fake docker: run without --name")
    if cidfile is not None and os.path.exists(cidfile):
        err(f"docker: container ID file found, make sure the other container isn't running or delete {cidfile}")
        sys.exit(125)

    run_fail = os.environ.get("FAKE_RUN_FAIL", "")
    if run_fail == "true":
        die("driver failed programming external connectivity")
    if run_fail == "foreign":
        state["containers"][name] = {"kind": "foreign", "running": True, "restart": "always", "publish": [],
                                     "image": "someone/else", "id": new_id()}
        save(state)
    if name in state["containers"]:
        die(f'Conflict. The container name "/{name}" is already in use')

    cid = new_id()
    state["containers"][name] = {
        "kind": "new",
        "running": True,
        "restart": restart,
        "publish": publish,
        "image": image,
        "trailing": trailing,
        "options": options,
        "id": cid,
    }
    if run_fail == "created":
        state["containers"][name].update(running=False, state="created")
    elif os.environ.get("FAKE_NEW_EXITS") == "restarted":
        state["containers"][name]["crash_loop"] = True
    elif os.environ.get("FAKE_NEW_EXITS") == "restarting":
        state["containers"][name]["state"] = "restarting"
    elif os.environ.get("FAKE_NEW_EXITS") == "exited":
        state["containers"][name]["running"] = False
    save(state)
    if cidfile is not None:
        with open(cidfile, "w") as f:
            f.write(cid)
    if run_fail == "created":
        die("driver failed programming external connectivity on endpoint: Bind for 0.0.0.0:8443 failed: port is already allocated")
    out(cid)


def main():
    argv = sys.argv[1:]
    with open(os.path.join(STATE_DIR, "calls.log"), "a") as log:
        log.write(json.dumps(argv) + "\n")

    if argv[:1] == ["--context"]:
        argv = argv[2:]
    if not argv:
        die("no command")
    if os.environ.get("FAKE_CONTEXT_PROMPTS") == "true" and os.getsid(0) == os.getpid():
        die("fake failure (the context prompts for a password and there is no terminal)")

    command_line = " ".join(argv)
    interrupted = signal_if_requested(command_line)
    fail_if_requested(command_line)

    state = load()
    command, args = argv[0], argv[1:]
    image = os.environ["IMAGE_TAG"]

    if interrupted:
        if command == "stop":
            stop_in_background(state, args[-1])
        sys.exit(130)

    if command in ("info", "buildx"):
        return
    if command == "save":
        with open(args[args.index("-o") + 1], "w") as f:
            f.write("image")
        return
    if command == "load":
        sys.stdin.read()
        out(f"Loaded image: {image}")
        return

    if command == "exec":
        interactive = args[0] == "-i"
        if interactive:
            args = args[1:]
        ref, curl_args = args[0], args[1:]
        exec_curl(state, ref, curl_args, sys.stdin.read() if interactive else "")
        return

    if command == "stop":
        ref = args[-1]
        _, c = container(state, ref)
        if os.environ.get("FAKE_STOP_FAIL") == "true":
            die(f"cannot stop container: {ref}")
        if cut_off_stop_requested():
            stop_in_background(state, ref)
            err("error during connect: connection reset by peer")
            sys.exit(1)
        if c.get("stopping_until") is not None:
            time.sleep(max(0.0, c["stopping_until"] - time.time()))
            state = load()
            _, c = container(state, ref)
        finish_stop(c)
        save(state)
        out(ref)
        return

    if command == "start":
        ref = args[-1]
        _, c = container(state, ref)
        if c["running"]:
            if c.get("state") == "paused":
                die("Error response from daemon: cannot start a paused container, try unpause instead")
            # Docker starts nothing, and resets nothing, for a container that is running, restarting or still stopping.
            out(ref)
            return
        c["running"] = True
        c.pop("state", None)
        c["restart_count"] = 0
        save(state)
        out(ref)
        return

    if command == "rm":
        force = "-f" in args
        ref = args[-1]
        found = resolve(state, ref)
        if found is None:
            if force:
                return
            die(f"No such container: {ref}")
        name, c = found
        if c["running"] and not force:
            die(f"cannot remove container {name}: container is running")
        del state["containers"][name]
        save(state)
        out(ref)
        return

    if command == "rename":
        ref, new = args
        name, c = container(state, ref)
        if new in state["containers"]:
            die(f'Conflict. The container name "/{new}" is already in use')
        state["containers"][new] = c
        del state["containers"][name]
        save(state)
        return

    if command == "update":
        ref = args[-1]
        container(state, ref)[1]["restart"] = args[args.index("--restart") + 1]
        save(state)
        out(ref)
        return

    if command == "logs":
        container(state, args[-1])
        out("fake controller log line")
        return

    if command == "inspect":
        inspect(state, args)
        return
    if command == "ps":
        ps(state, args)
        return

    if command == "run":
        run(state, args, image)
        return

    die(f"fake docker: unsupported command {command}")


def entry():
    code = 0
    try:
        main()
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
    try:
        if sys.stdout is not None:
            sys.stdout.flush()
    except (OSError, ValueError):
        pass
    os._exit(code)


entry()
