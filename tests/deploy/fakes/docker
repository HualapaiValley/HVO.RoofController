#!/usr/bin/env python3
"""Fake `docker` CLI for deploy-script-tests.sh.

Keeps containers in $FAKE_STATE_DIR/state.json (keyed by name, each with a 64-hex "id") and appends every call's argv
(as JSON) to $FAKE_STATE_DIR/calls.log. Commands take a container name or an ID prefix, as docker does. A container's
docker state is "running" or "exited" from its "running" flag, or its optional "state" (paused, restarting, created);
stop and start clear "state". `ps` supports -a, --no-trunc, --filter name=<regex>|id=<prefix> and Go-style --format
({{.Label "<key>"}} reads the container's optional "labels", as a Compose-created container has).
`inspect` supports two --format templates: '{{range .Config.Env}}{{println .}}{{end}}', the --env/-e values the
container was run with (its "options"), and '{{.State.Status}} {{.RestartCount}}', its docker state and optional
"restart_count". Starting a stopped container resets the count to 0, as docker start does; starting a running or
restarting one changes nothing, and starting a paused one fails. The deploy script's HostConfig template reports the
privileges and limits the container was run with (--read-only, --cap-drop, --cap-add, --security-opt, --cpus,
--memory, --memory-swap, --pids-limit in its "options"), as `update` changed them (its "limits", which a test may seed);
a seeded container has none, as one deployed before them. `update` changes them as Docker does: 0 leaves a limit as it
is (so a CPU or memory limit cannot be taken off), and a process limit of -1 takes that one off (reported as 0).
Container behaviour is chosen per container "kind" (old, current, new, ...) with environment variables:
  FAKE_<KIND>_READY=false          /health/ready fails
  FAKE_<KIND>_STATUS_CODE=<code>   HTTP status of the in-container GET Status (default 200)
  FAKE_<KIND>_MOTION=<motion>      commandedMotion of the in-container GET Status (default None); isMoving is true when
                                   it is not None
  FAKE_<KIND>_STOP=unverified      the in-container POST Stop is not verified (error: the exec fails)
  FAKE_<KIND>_HAT_MODE=<mode>      hatMode of the in-container Status and Stop (absent: no hatMode, as before emulator
                                   mode). By default Emulated when the container was run with HatEmulator__Enabled=true
                                   (the last one given), otherwise Physical.
  FAKE_<KIND>_PHYSICAL=true|false  isUsingPhysicalHardware of the same responses (default false for hatMode Simulation,
                                   otherwise true)
  FAKE_<KIND>_WEB_LIVE=false       the web UI's /health/live fails inside the container
  FAKE_<KIND>_SUPERVISOR=<view>    what `exec <c> cat /run/hvo-roof/supervisor.json` finds (by default both processes
                                   running, each started once): absent (no such file, as in an image from before the
                                   supervisor), restarting (the controller waits to start again), crash-loop (the
                                   controller is left stopped), restarted (each read finds the controller started once
                                   more), first-start (the first read finds the controller not started yet, starting
                                   with 0 starts, as the supervisor writes it while it turns the relays off, and
                                   /health/ready fails until a later read; each later read finds it running, started
                                   once), first-start-restarted (the same, but started
                                   twice after the first read), ui-restarting, or ui-restarted (the same for the web UI)
Other switches:
  FAKE_PREFLIGHT_EXIT=<code>       exit code of `run --rm ... --validate-deployment`
  FAKE_RUN_FAIL=true               `run -d` fails before creating the container
  FAKE_RUN_FAIL=created            `run -d` creates the container (state created, ID in the --cidfile), then fails
  FAKE_RUN_FAIL=foreign            another client's running container (kind foreign) takes the name; `run -d` fails
  FAKE_NEW_EXITS=restarted|restarting|exited
                                   `run -d` succeeds, but the controller it starts exits at once (it passed the
                                   pre-flight, then failed on its normal start). With --restart unless-stopped Docker
                                   restarts it: restarted is running again, and each inspect finds it restarted once
                                   more (a crash loop); restarting is waiting to restart; exited is stopped, as when
                                   Docker cannot start it again (a device has gone).
  FAKE_PULL_FAIL=true              `pull` fails (the registry cannot be reached), and pulls nothing
  FAKE_PULLED_DIGEST=sha256:<hex>  the digest `pull` records for the image (default: the digest in the reference)
  FAKE_PULLED_PLATFORM=<os/arch>   the platform `pull` gets (default: its --platform), as from a reference that names a
                                   single image of another platform
  FAKE_IMAGE_STORE=containerd      `image inspect --platform` for a platform the image store does not hold prints empty
                                   fields ("/"), as Docker's containerd store does; by default it fails, as the classic
                                   store does
  FAKE_INSPECT_PLATFORM=false      the CLI has no `image inspect --platform` (Docker before 28)
  FAKE_LOAD_FAIL=true              `load -i <archive>` fails, and loads nothing
  FAKE_ON_LOAD=<shell command>     runs just before `load -i <archive>` reads the archive (a test changes the release's
                                   archive there, once the deploy script has checked it), with FAKE_LOAD_ARCHIVE the path
                                   it was given
  FAKE_AFTER_LOAD=<shell command>  runs once `load -i <archive>` has read the archive, with FAKE_LOAD_ARCHIVE the same
                                   (a test changes the script's own folders there, before the script removes them)
  FAKE_LOADED_ID=sha256:<hex>      the ID `load -i <archive>` gives the image (default: its config's digest, as Docker's
                                   classic image store does, or its index's with FAKE_IMAGE_STORE=containerd)
  FAKE_INFO_<FIELD>=<value>        what `info --format` reports for MemoryLimit, CPUCfsQuota, PidsLimit and SwapLimit
                                   (default true each), NCPU (default 4), MemTotal (default 8 GiB), CgroupVersion
                                   (default 2) and Name (Docker's host name, default pi-test-host), as
                                   FAKE_INFO_MEMORYLIMIT=false; an empty value is a field Docker does not report
  FAKE_INFO_WARNINGS=<w>[;<w>...]  the warnings `info --format '{{range .Warnings}}{{println .}}{{end}}'` lists (none by
                                   default)
  `volume ls/inspect/rm/create`    the deploy script's desired-limits records, volumes kept in the state's "volumes"
                                   with their labels (seed_desired_limits seeds one)
  FAKE_VOLUME_HIDDEN=<name>        `volume ls` does not list that volume (another run creates it after this one lists)
  FAKE_CONTAINER_LOG_FAIL=true     `exec -i <c> sh -c 'cat > /proc/1/fd/2'` (a line for the container's log, which the
                                   fake keeps in the container's "log") fails
  FAKE_CONTEXT_HOST=<endpoint>     what `context inspect --format '{{.Endpoints.docker.Host}}' <context>` reports
                                   (default ssh://roof@pi.test: Docker on another machine)
  FAKE_DROPPED_LIMIT=memory|cpus|pids
                                   `run -d` drops that limit, as Docker does with only a warning when the kernel cannot
                                   enforce it
  FAKE_STOP_FAIL=true              `stop` fails
  FAKE_STOP_CUT_OFF=true           the first `stop` loses its connection: the client fails and the daemon finishes the
                                   stop by itself FAKE_ASYNC_STOP_SECONDS (default 1) later
  FAKE_FAIL="<text>[@N];..."       a call whose argv (space-joined, without --context) contains <text> fails; with @N
                                   only the N-th such call
  FAKE_SIGNAL_ON=<text>[;<text>]   the first call containing <text> sends FAKE_SIGNAL (default TERM) to the script
                                   (pid in script.pid), then runs normally; with FAKE_SIGNAL_KILLS_OUTPUT=true it first
                                   kills the process reading the script's output (pid in output.pid). Each further
                                   <text> is armed once the one before it has fired.
  FAKE_CONTEXT_PROMPTS=true        the context asks for a password (an ssh:// context without a key): a call in its own
                                   session, with no terminal to prompt on, fails; any other call succeeds, as if the
                                   password had been typed
  FAKE_SIGNAL_GROUP=true           the signal goes to the script's process group, as a Ctrl-C at the terminal does: a
                                   call in that group is cut short, as Docker CLI 27+ is on SIGINT even when the signal
                                   is ignored. The daemon still finishes a `stop` FAKE_ASYNC_STOP_SECONDS later; any
                                   other request is dropped. A call in its own session is not reached.
A container whose stop the daemon is still finishing stays running until then; `start` does nothing to it and `stop`
waits for it.
Images pulled with `pull [--platform <p>] <ref>` are kept by reference, with a digest, a platform and version labels;
`image inspect` supports --help, --platform and four --format templates: the RepoDigests, '{{.Os}}/{{.Architecture}}',
the version and revision labels, and '{{.Id}}'. An offline archive loaded with `load -i <archive>` (a release's, as
build/release-assets.py writes it) is kept by its ID, with the platforms it holds and its config's labels: the classic
store reads its manifest.json, the containerd store (FAKE_IMAGE_STORE=containerd) its index.json. The file is read once,
and each load is kept in the state's "loads": the path read, the SHA-256 of what was read, and the modes of the file and
its folder. `run` finds its image
among its arguments: IMAGE_REF or IMAGE_TAG, or an image it holds.
Containers created by `run -d` have kind "new". Authenticated calls must send FAKE_EXPECTED_KEY on stdin (-H @-),
otherwise they get 401. Output errors (closed or broken stdout/stderr) are ignored, as they would not change Docker.
"""
import json
import hashlib
import io
import os
import re
import secrets
import signal
import subprocess
import sys
import tarfile
import time

STATE_DIR = os.environ["FAKE_STATE_DIR"]
STATE_FILE = os.path.join(STATE_DIR, "state.json")
VERIFIED = {"relayRegisterState": "Verified", "relayRegisterMask": 0, "commandedMotion": "None"}
UNVERIFIED = {"relayRegisterState": "Unknown", "relayRegisterMask": None, "commandedMotion": "None"}


def out(text="", end="\n"):
    try:
        if sys.stdout is not None:
            sys.stdout.write(text + end)
    except (OSError, ValueError):
        pass


def err(text):
    try:
        if sys.stderr is not None:
            sys.stderr.write(text + "\n")
            sys.stderr.flush()
    except (OSError, ValueError):
        pass


def die(message, code=1):
    err(f"Error response from daemon: {message}")
    sys.exit(code)


def load():
    try:
        with open(STATE_FILE) as f:
            state = json.load(f)
    except FileNotFoundError:
        state = {"containers": {}}
    changed = False
    for c in state["containers"].values():
        if not c.get("id"):
            c["id"] = secrets.token_hex(32)
            changed = True
        if c.get("stopping_until") is not None and c["stopping_until"] <= time.time():
            finish_stop(c)
            changed = True
    if changed:
        save(state)
    return state


def save(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def finish_stop(c):
    c.pop("stopping_until", None)
    c["running"] = False
    c.pop("state", None)


def stop_in_background(state, ref):
    """The daemon goes on stopping the container after its client has gone."""
    _, c = container(state, ref)
    if c["running"] and c.get("stopping_until") is None:
        c["stopping_until"] = time.time() + float(os.environ.get("FAKE_ASYNC_STOP_SECONDS", "1"))
        save(state)


def behaviour(kind, name, default):
    return os.environ.get(f"FAKE_{kind.upper()}_{name}", default)


def with_hat_mode(c, body):
    mode = behaviour(c["kind"], "HAT_MODE", "")
    if not mode:
        enabled = [o for o in c.get("options", []) if o.startswith("HatEmulator__Enabled=")]
        mode = "Emulated" if enabled and enabled[-1] == "HatEmulator__Enabled=true" else "Physical"
    physical = behaviour(c["kind"], "PHYSICAL", "false" if mode == "Simulation" else "true")
    body = dict(body, isUsingPhysicalHardware=physical == "true")
    return body if mode == "absent" else dict(body, hatMode=mode)


def env_of(c):
    options, env = c.get("options", []), []
    for i, value in enumerate(options):
        if value in ("--env", "-e") and i + 1 < len(options):
            env.append(options[i + 1])
        elif value.startswith("--env="):
            env.append(value[len("--env="):])
    return env


HOST_CONFIG_FORMAT = ("{{.HostConfig.ReadonlyRootfs}} {{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} "
                      "{{json .HostConfig.PidsLimit}} {{json .HostConfig.CapDrop}} {{json .HostConfig.CapAdd}} {{json .HostConfig.SecurityOpt}}")
UNITS = {"b": 1, "k": 1024, "m": 1024 ** 2, "g": 1024 ** 3}


def to_bytes(value):
    value = value.lower()
    return int(value[:-1]) * UNITS[value[-1]] if value[-1] in UNITS else int(value)


def option_values(options, name):
    """Every value of an option given as `name value` or `name=value`."""
    values = []
    for i, value in enumerate(options):
        if value == name and i + 1 < len(options):
            values.append(options[i + 1])
        elif value.startswith(name + "="):
            values.append(value[len(name) + 1:])
    return values


def limits_of(options):
    """The limits Docker records for these run options: NanoCpus, Memory, MemorySwap and PidsLimit (None when unset)."""
    limits = {}
    for name, key, convert in (("--cpus", "nano", lambda v: round(float(v) * 1e9)), ("--memory", "memory", to_bytes),
                               ("--memory-swap", "swap", to_bytes), ("--pids-limit", "pids", int)):
        given = option_values(options, name)
        if given:
            limits[key] = convert(given[-1])
    if limits.get("swap") is not None and os.environ.get("FAKE_INFO_SWAPLIMIT", "true") != "true":
        limits["swap"] = -1
    return limits


def host_config(c):
    options = c.get("options", [])
    limits = dict(limits_of(options), **c.get("limits", {}))
    caps = lambda name: [v if v == "ALL" else "CAP_" + v.upper().removeprefix("CAP_") for v in option_values(options, name)] or None
    return " ".join([
        "true" if "--read-only" in options else "false",
        str(limits.get("nano", 0)), str(limits.get("memory", 0)), str(limits.get("swap", 0)),
        json.dumps(limits.get("pids")), json.dumps(caps("--cap-drop"), separators=(",", ":")),
        json.dumps(caps("--cap-add"), separators=(",", ":")),
        json.dumps(option_values(options, "--security-opt") or None, separators=(",", ":"))])


def inspect(state, args):
    fmt, refs, i = None, [], 0
    while i < len(args):
        if args[i] in ("--format", "-f"):
            fmt, i = args[i + 1], i + 2
        else:
            refs.append(args[i])
            i += 1
    if fmt not in ("{{json .Config.Env}}", "{{range .Config.Env}}{{println .}}{{end}}", "{{.State.Status}} {{.RestartCount}}", "{{.Image}}", "{{.HostConfig.RestartPolicy.Name}}", HOST_CONFIG_FORMAT):
        die(f"fake docker: unsupported inspect format: {fmt}")
    for ref in refs:
        _, c = container(state, ref)
        if fmt == HOST_CONFIG_FORMAT:
            out(host_config(c))
        elif fmt == "{{.Image}}":
            out("sha256:" + hashlib.sha256(c["kind"].encode()).hexdigest())
        elif fmt == "{{.HostConfig.RestartPolicy.Name}}":
            out(c["restart"])
        elif fmt.startswith("{{.State"):
            if c.get("crash_loop"):
                c["restart_count"] = c.get("restart_count", 0) + 1
                save(state)
            out(f"{docker_state(c)} {c.get('restart_count', 0)}")
        else:
            # println ends each value with a newline, and docker adds one after the template.
            values = env_of(c)
            if (os.environ.get("FAKE_IDENTITY_ENV_MISSING") != "true"
                    and not any(e.split("=", 1)[0].replace("__", ":").lower() == "roofcontrollersecurity:identity:storepath" for e in values)):
                values.append("RoofControllerSecurity__Identity__StorePath=/var/lib/hvo-roof/identity/identity.json")
            if fmt == "{{json .Config.Env}}":
                out(json.dumps(values))
            else:
                out("".join(f"{e}\n" for e in values))


IMAGE_FORMATS = {
    "{{range .RepoDigests}}{{println .}}{{end}}": "digests",
    "{{.Os}}/{{.Architecture}}": "platform",
    '{{with .Config}}{{index .Labels "org.opencontainers.image.version"}} '
    '{{index .Labels "org.opencontainers.image.revision"}}{{end}}': "labels",
    "{{.Id}}": "id",
}


def load_archive(state, path):
    """`load -i <archive>`: an offline image archive, loaded as Docker's classic image store loads one (its manifest.json:
    the image's ID is its config's digest) or, with FAKE_IMAGE_STORE=containerd, as the containerd store does (its
    index.json: the ID is the index's digest, holding each platform whose manifest the archive has)."""
    hook_env = {**os.environ, "FAKE_LOAD_ARCHIVE": path}
    if os.environ.get("FAKE_ON_LOAD"):
        subprocess.run(["/bin/sh", "-c", os.environ["FAKE_ON_LOAD"]], check=True, env=hook_env)
    if os.environ.get("FAKE_LOAD_FAIL") == "true":
        die("unexpected EOF")
    with open(path, "rb") as f:
        data = f.read()
    state.setdefault("loads", []).append({
        "path": path,
        "sha256": hashlib.sha256(data).hexdigest(),
        "mode": oct(os.stat(path).st_mode & 0o777),
        "folder_mode": oct(os.stat(os.path.dirname(os.path.abspath(path))).st_mode & 0o777),
    })
    if os.environ.get("FAKE_AFTER_LOAD"):
        subprocess.run(["/bin/sh", "-c", os.environ["FAKE_AFTER_LOAD"]], check=True, env=hook_env)
    with tarfile.open(fileobj=io.BytesIO(data)) as tar:
        names = set(tar.getnames())

        def read(name):
            return tar.extractfile(name).read()

        index = json.loads(read("index.json"))["manifests"][0]
        docker = json.loads(read("manifest.json"))[0]
        config_bytes = read(docker["Config"])
        config = json.loads(config_bytes)
        if os.environ.get("FAKE_IMAGE_STORE") == "containerd":
            image_id = index["digest"]
            platforms = [f"{m['platform']['os']}/{m['platform']['architecture']}"
                         for m in json.loads(read("blobs/sha256/" + index["digest"][7:]))["manifests"]
                         if "blobs/sha256/" + m["digest"][7:] in names]
        else:
            image_id = "sha256:" + hashlib.sha256(config_bytes).hexdigest()
            platforms = [f"{config['os']}/{config['architecture']}"]
    image_id = os.environ.get("FAKE_LOADED_ID") or image_id
    labels = (config.get("config") or {}).get("Labels") or {}
    state.setdefault("images", {})[image_id] = {
        "id": image_id,
        "repo_digests": [],
        "platform": platforms[0],
        "platforms": platforms,
        "version": labels.get("org.opencontainers.image.version", ""),
        "revision": labels.get("org.opencontainers.image.revision", ""),
    }
    save(state)
    tags = docker.get("RepoTags") or []
    out("".join(f"Loaded image: {tag}\n" for tag in tags) if tags else f"Loaded image ID: {image_id}\n", end="")


def pull(state, args):
    platform, ref = None, args[-1]
    if "--platform" in args:
        platform = args[args.index("--platform") + 1]
    if os.environ.get("FAKE_PULL_FAIL") == "true":
        die(f"Get \"https://{ref.split('/')[0]}/v2/\": dial tcp: lookup {ref.split('/')[0]}: no such host")
    name, _, digest = ref.partition("@")
    repository = name if ":" not in name.rsplit("/", 1)[-1] else name.rsplit(":", 1)[0]
    digest = os.environ.get("FAKE_PULLED_DIGEST") or digest
    state.setdefault("images", {})[ref] = {
        "repo_digests": [f"{repository}@{digest}"],
        "platform": os.environ.get("FAKE_PULLED_PLATFORM") or platform or "linux/amd64",
        "version": "4.0.0",
        "revision": "0123456789abcdef0123456789abcdef01234567",
    }
    save(state)
    out(f"{digest.split(':')[1][:12]}: Pull complete")
    out(f"Digest: {digest}")
    out(f"Status: Downloaded newer image for {ref}")


def image_inspect(state, args):
    if "--help" in args:
        out("Usage:  docker image inspect [OPTIONS] IMAGE [IMAGE...]")
        out("  -f, --format string     Format output using a custom template")
        if os.environ.get("FAKE_INSPECT_PLATFORM") != "false":
            out("      --platform string   Inspect a specific platform of the multi-platform image.")
        return
    fmt, platform, refs, i = None, None, [], 0
    while i < len(args):
        if args[i] in ("--format", "-f"):
            fmt, i = args[i + 1], i + 2
        elif args[i] == "--platform":
            if os.environ.get("FAKE_INSPECT_PLATFORM") == "false":
                err("unknown flag: --platform")
                sys.exit(125)
            platform, i = args[i + 1], i + 2
        else:
            refs.append(args[i])
            i += 1
    if fmt == '{{index .Config.Labels "io.hvo.roof.identity-schema"}}':
        for ref in refs:
            matches = [c for c in state["containers"].values()
                       if ref == "sha256:" + hashlib.sha256(c["kind"].encode()).hexdigest()]
            if not matches:
                die("Unknown immutable image ID")
            c = matches[0]
            out(os.environ.get("FAKE_" + c["kind"].upper() + "_IDENTITY_CAPABILITY", ""))
        return
    field = IMAGE_FORMATS.get(fmt)
    if field is None:
        die(f"fake docker: unsupported image inspect format: {fmt}")
    for ref in refs:
        image = state.get("images", {}).get(ref)
        if image is None:
            die(f"No such image: {ref}")
        if platform is not None and platform not in image.get("platforms", [image["platform"]]):
            if os.environ.get("FAKE_IMAGE_STORE") != "containerd":
                die(f"image with reference {ref} was found but does not match the specified platform: "
                    f"wanted {platform}, actual: {image['platform']}")
            # The image's own record (its digests) is still there; the platform's fields are empty.
            if field != "digests":
                out({"platform": "/", "labels": ""}[field])
                continue
        if field == "digests":
            out("".join(f"{d}\n" for d in image["repo_digests"]))
        elif field == "platform":
            out(platform or image["platform"])
        elif field == "id":
            out(image.get("id", ref))
        else:
            out(f"{image['version']} {image['revision']}")


def docker_state(c):
    return c.get("state") or ("running" if c["running"] else "exited")


def resolve(state, ref):
    """(name, container) for a name, a full ID or a unique ID prefix; None when there is no such container."""
    containers = state["containers"]
    if ref in containers:
        return ref, containers[ref]
    matches = [(n, c) for n, c in containers.items() if c["id"].startswith(ref)] if ref else []
    if len(matches) > 1:
        die(f"multiple IDs found with provided prefix: {ref}")
    return matches[0] if matches else None


def container(state, ref):
    found = resolve(state, ref)
    if found is None:
        die(f"No such container: {ref}")
    return found


def new_id():
    return secrets.token_hex(32)


def fail_if_requested(command_line):
    spec = os.environ.get("FAKE_FAIL", "")
    if not spec:
        return
    counts_file = os.path.join(STATE_DIR, "fail-counts.json")
    try:
        with open(counts_file) as f:
            counts = json.load(f)
    except FileNotFoundError:
        counts = {}
    fail = None
    for entry in filter(None, spec.split(";")):
        text, nth = entry, None
        if "@" in entry and entry.rsplit("@", 1)[1].isdigit():
            text, nth = entry.rsplit("@", 1)[0], int(entry.rsplit("@", 1)[1])
        if text in command_line:
            counts[entry] = counts.get(entry, 0) + 1
            if nth is None or counts[entry] == nth:
                fail = text
    with open(counts_file, "w") as f:
        json.dump(counts, f)
    if fail is not None:
        die(f"fake failure ({fail})")


def read_pid(name, wait_seconds=0.0):
    path = os.path.join(STATE_DIR, name)
    deadline = time.monotonic() + wait_seconds
    while True:
        try:
            with open(path) as f:
                return int(f.read().strip())
        except (FileNotFoundError, ValueError):
            if time.monotonic() >= deadline:
                return None
            time.sleep(0.05)


def signal_if_requested(command_line):
    """Sends the next requested signal; True when it also cuts this call short (FAKE_SIGNAL_GROUP)."""
    triggers = [t for t in os.environ.get("FAKE_SIGNAL_ON", "").split(";") if t]
    counter = os.path.join(STATE_DIR, "signals.sent")
    try:
        with open(counter) as f:
            sent = int(f.read().strip() or "0")
    except FileNotFoundError:
        sent = 0
    if sent >= len(triggers) or triggers[sent] not in command_line:
        return False
    with open(counter, "w") as f:
        f.write(str(sent + 1))
    if os.environ.get("FAKE_SIGNAL_KILLS_OUTPUT") == "true" and sent == 0:
        reader = read_pid("output.pid", wait_seconds=5.0)
        if reader is not None:
            try:
                os.kill(reader, signal.SIGKILL)
            except ProcessLookupError:
                pass
            time.sleep(0.2)
    script = read_pid("script.pid")
    if script is None:
        return False
    os.kill(script, getattr(signal, "SIG" + os.environ.get("FAKE_SIGNAL", "TERM")))
    if os.environ.get("FAKE_SIGNAL_GROUP") != "true":
        return False
    try:
        return os.getpgid(script) == os.getpgrp()
    except ProcessLookupError:
        return False


def cut_off_stop_requested():
    if os.environ.get("FAKE_STOP_CUT_OFF") != "true":
        return False
    marker = os.path.join(STATE_DIR, "stop-cut-off")
    if os.path.exists(marker):
        return False
    open(marker, "w").close()
    return True


# The supervisor's state file as it writes it (tests/container/supervisor-tests.sh checks the sample against its output).
SUPERVISOR_SAMPLE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "container",
                                 "supervisor-state.sample.json")


def supervisor_json(state, c):
    """The container supervisor's state file (the sample's format), as FAKE_<KIND>_SUPERVISOR says."""
    view = behaviour(c["kind"], "SUPERVISOR", "")
    if view == "absent":
        die("cat: /run/hvo-roof/supervisor.json: No such file or directory")
    processes = {"controller": ["running", 1], "ui": ["running", 1]}
    name = "ui" if view.startswith("ui-") else "controller"
    view = view.removeprefix("ui-")
    if view == "restarting":
        processes[name][0] = "restarting"
    elif view == "crash-loop":
        processes[name] = ["crash-loop", 5]
    elif view == "restarted":
        key = f"supervised_{name}_starts"
        c[key] = c.get(key, 1) + 1
        save(state)
        processes[name][1] = c[key]
    elif view in ("first-start", "first-start-restarted"):
        key = f"supervised_{name}_reads"
        c[key] = c.get(key, 0) + 1
        save(state)
        processes[name] = (["starting", 0] if c[key] == 1
                           else ["running", 1 if view == "first-start" else 2])
    with open(SUPERVISOR_SAMPLE, encoding="utf-8") as sample:
        document = json.load(sample)
    document["lastForcedRestart"] = None
    for process, (process_state, starts) in processes.items():
        document[process].update(state=process_state, pid=42 if process_state == "running" else None, starts=starts,
                                 recentCrashes=0, lastExitCode=None, lastExitReason=None, lastExitAt=None)
    out(json.dumps(document, separators=(",", ":")))


def exec_curl(state, ref, curl_args, stdin_text):
    name, c = container(state, ref)
    current = docker_state(c)
    if current == "paused":
        die(f"Container {c['id']} is paused, unpause the container before exec")
    if current == "restarting":
        die(f"Container {c['id']} is restarting, wait until the container is running")
    if not c["running"]:
        die(f"container {name} is not running")
    kind = c["kind"]
    if curl_args == ["cat", "/run/hvo-roof/supervisor.json"]:
        supervisor_json(state, c)
        return
    if curl_args == ["sh", "-c", "cat > /proc/1/fd/2"]:
        # A line for the container's log (docker logs): its first process's standard error.
        if os.environ.get("FAKE_CONTAINER_LOG_FAIL") == "true":
            die("sh: 1: cannot create /proc/1/fd/2: Permission denied")
        c.setdefault("log", []).extend(stdin_text.splitlines())
        save(state)
        return
    url = curl_args[-1]
    method = curl_args[curl_args.index("-X") + 1] if "-X" in curl_args else "GET"

    if url.endswith("/health/ready"):
        # A controller the supervisor has not started yet (the first-start views' first read) is not ready.
        if behaviour(kind, "SUPERVISOR", "").startswith("first-start") and c.get("supervised_controller_reads", 0) < 2:
            sys.exit(22)
        sys.exit(0 if behaviour(kind, "READY", "true") == "true" else 22)
    if url.endswith("/health/live"):
        sys.exit(0 if behaviour(kind, "WEB_LIVE", "true") == "true" else 22)

    if "@-" in curl_args and stdin_text.strip() != f"X-Api-Key: {os.environ['FAKE_EXPECTED_KEY']}":
        out('{"error":"unauthorized"}\n401', end="")
        return

    if url.endswith("/Status") and method == "GET":
        code = behaviour(kind, "STATUS_CODE", "200")
        motion = behaviour(kind, "MOTION", "None")
        body = dict(VERIFIED, commandedMotion=motion, isMoving=motion != "None")
        out(json.dumps(with_hat_mode(c, body)) + "\n" + code, end="")
    elif url.endswith("/Stop") and method == "POST":
        stop = behaviour(kind, "STOP", "verified")
        if stop == "error":
            die("exec failed")
        out(json.dumps(with_hat_mode(c, VERIFIED if stop == "verified" else UNVERIFIED)) + "\n200", end="")
    else:
        out("{}\n404", end="")


def status_text(c):
    return {
        "running": "Up 2 minutes",
        "paused": "Up 2 minutes (Paused)",
        "restarting": "Restarting (1) 3 seconds ago",
        "created": "Created",
    }.get(docker_state(c), "Exited (0) 1 minute ago")


def ps(state, args):
    show_all = no_trunc = False
    filters, fmt = [], None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-a", "--all"):
            show_all = True
        elif a == "--no-trunc":
            no_trunc = True
        elif a == "--filter":
            filters.append(args[i + 1])
            i += 1
        elif a == "--format":
            fmt = args[i + 1]
            i += 1
        else:
            die(f"fake docker: unsupported ps option {a}")
        i += 1

    def matches(name, c):
        if not show_all and not c["running"]:
            return False
        for f in filters:
            key, _, value = f.partition("=")
            if key == "name":
                if not (re.search(value, "/" + name) or re.search(value, name)):
                    return False
            elif key == "id":
                if not c["id"].startswith(value):
                    return False
            else:
                die(f"fake docker: unsupported ps filter {key}")
        return True

    fmt = fmt or "table {{.ID}}\t{{.Names}}\t{{.Status}}"
    table = fmt.startswith("table ")
    if table:
        fmt = fmt[len("table "):]
    fmt = fmt.replace("\\t", "\t")
    headers = {"ID": "CONTAINER ID", "Names": "NAMES", "Status": "STATUS", "Image": "IMAGE", "State": "STATE"}
    if table:
        out(re.sub(r"\{\{\.(\w+)\}\}", lambda m: headers[m.group(1)], fmt))
    for name, c in state["containers"].items():
        if matches(name, c):
            fields = {
                "ID": c["id"] if no_trunc else c["id"][:12],
                "Names": name,
                "Status": status_text(c),
                "Image": c.get("image", os.environ["IMAGE_TAG"]),
                "State": docker_state(c),
            }

            def field(m):
                if m.group(1) == "Label":
                    return c.get("labels", {}).get(m.group(2), "")
                return fields[m.group(1)]

            out(re.sub(r'\{\{\.(\w+)(?: "([^"]*)")?\}\}', field, fmt))


def run(state, args, image):
    image = next((candidate for candidate in [image, *state.get("images", {})] if candidate in args), image)
    position = args.index(image)
    options, trailing = args[:position], args[position + 1:]
    if "--rm" in options:
        out("Deployment check (Production):")
        code = int(os.environ.get("FAKE_PREFLIGHT_EXIT", "0"))
        out("Deployment check passed." if code == 0 else "  PROBLEM: fake problem")
        sys.exit(code)

    name, cidfile, restart, publish = None, None, None, []
    for i, value in enumerate(options):
        following = options[i + 1] if i + 1 < len(options) else None
        if value == "--name":
            name = following
        elif value.startswith("--name="):
            name = value[len("--name="):]
        elif value == "--cidfile":
            cidfile = following
        elif value == "--restart":
            restart = following
        elif value == "-p":
            publish.append(following)
    if name is None:
        die("fake docker: run without --name")
    if cidfile is not None and os.path.exists(cidfile):
        err(f"docker: container ID file found, make sure the other container isn't running or delete {cidfile}")
        sys.exit(125)

    run_fail = os.environ.get("FAKE_RUN_FAIL", "")
    if run_fail == "true":
        die("driver failed programming external connectivity")
    if run_fail == "foreign":
        state["containers"][name] = {"kind": "foreign", "running": True, "restart": "always", "publish": [],
                                     "image": "someone/else", "id": new_id()}
        save(state)
    if name in state["containers"]:
        die(f'Conflict. The container name "/{name}" is already in use')

    cid = new_id()
    dropped = {"memory": {"memory": 0, "swap": 0}, "cpus": {"nano": 0}, "pids": {"pids": None}}.get(
        os.environ.get("FAKE_DROPPED_LIMIT", ""), {})
    state["containers"][name] = {
        "kind": "new",
        "running": True,
        "restart": restart,
        "publish": publish,
        "image": image,
        "trailing": trailing,
        "options": options,
        "limits": dropped,
        "id": cid,
    }
    if not run_fail and os.environ.get("FAKE_NEW_IDENTITY_DOCUMENT") is not None:
        with open(os.environ["FAKE_IDENTITY_SOURCE"], "w") as identity:
            identity.write(os.environ["FAKE_NEW_IDENTITY_DOCUMENT"])
    if run_fail == "created":
        state["containers"][name].update(running=False, state="created")
    elif os.environ.get("FAKE_NEW_EXITS") == "restarted":
        state["containers"][name]["crash_loop"] = True
    elif os.environ.get("FAKE_NEW_EXITS") == "restarting":
        state["containers"][name]["state"] = "restarting"
    elif os.environ.get("FAKE_NEW_EXITS") == "exited":
        state["containers"][name]["running"] = False
    save(state)
    if cidfile is not None:
        with open(cidfile, "w") as f:
            f.write(cid)
    if run_fail == "created":
        die("driver failed programming external connectivity on endpoint: Bind for 0.0.0.0:8443 failed: port is already allocated")
    out(cid)


def main():
    argv = sys.argv[1:]
    with open(os.path.join(STATE_DIR, "calls.log"), "a") as log:
        log.write(json.dumps(argv) + "\n")

    if argv[:1] == ["--context"]:
        argv = argv[2:]
    if not argv:
        die("no command")
    if os.environ.get("FAKE_CONTEXT_PROMPTS") == "true" and os.getsid(0) == os.getpid():
        die("fake failure (the context prompts for a password and there is no terminal)")

    command_line = " ".join(argv)
    interrupted = signal_if_requested(command_line)
    fail_if_requested(command_line)

    state = load()
    command, args = argv[0], argv[1:]
    image = os.environ.get("IMAGE_REF") or os.environ["IMAGE_TAG"]

    if interrupted:
        if command == "stop":
            stop_in_background(state, args[-1])
        sys.exit(130)

    if command == "info" and "--format" in args:
        fmt = args[args.index("--format") + 1]
        values = {"MemoryLimit": "true", "CPUCfsQuota": "true", "PidsLimit": "true", "SwapLimit": "true",
                  "NCPU": "4", "MemTotal": str(8 * 1024 ** 3), "CgroupVersion": "2", "Name": "pi-test-host"}
        warnings = [w for w in os.environ.get("FAKE_INFO_WARNINGS", "").split(";") if w]
        fmt = fmt.replace("{{range .Warnings}}{{println .}}{{end}}", "".join(w + "\n" for w in warnings))
        out(re.sub(r"\{\{\.(\w+)\}\}", lambda m: os.environ.get("FAKE_INFO_" + m.group(1).upper(), values[m.group(1)]), fmt),
            end="" if fmt.endswith("\n") else "\n")
        return
    if command == "volume":
        # The desired limits' records (the deploy script's volumes): ls --quiet --filter name=<text> (Docker's partial
        # match), inspect --format with their labels, rm --force, and create --label k=v... <name>. Kept in the state's
        # "volumes".
        volumes = state.setdefault("volumes", {})
        sub, rest = args[0], args[1:]
        if sub == "ls":
            text = rest[rest.index("--filter") + 1].removeprefix("name=") if "--filter" in rest else ""
            hidden = os.environ.get("FAKE_VOLUME_HIDDEN", "")
            for name in sorted(volumes):
                if text in name and name != hidden:
                    out(name)
            return
        if sub == "inspect":
            fmt, name = rest[rest.index("--format") + 1], rest[-1]
            if name not in volumes:
                die(f"Error response from daemon: get {name}: no such volume")
            labels = volumes[name].get("labels", {})
            out(re.sub(r'\{\{index \.Labels "([^"]+)"\}\}', lambda m: labels.get(m.group(1), ""), fmt))
            return
        if sub == "rm":
            name = rest[-1]
            if name not in volumes and "--force" not in rest and "-f" not in rest:
                die(f"Error response from daemon: get {name}: no such volume")
            volumes.pop(name, None)
            save(state)
            return
        if sub == "create":
            # Docker answers a create for a name it has with that volume, as it is.
            labels = dict(value.split("=", 1) for value in option_values(rest, "--label"))
            volumes.setdefault(rest[-1], {"labels": labels})
            save(state)
            out(rest[-1])
            return
        die(f"fake docker: unexpected volume command {args}")
    if command == "context" and args[:1] == ["inspect"]:
        out(os.environ.get("FAKE_CONTEXT_HOST", "ssh://roof@pi.test"))
        return
    if command in ("info", "buildx"):
        return
    if command == "save":
        with open(args[args.index("-o") + 1], "w") as f:
            f.write("image")
        return
    if command == "load":
        if "-i" in args:
            load_archive(state, args[args.index("-i") + 1])
            return
        sys.stdin.read()
        out(f"Loaded image: {image}")
        return

    if command == "exec":
        interactive = args[0] == "-i"
        if interactive:
            args = args[1:]
        ref, curl_args = args[0], args[1:]
        exec_curl(state, ref, curl_args, sys.stdin.read() if interactive else "")
        return

    if command == "stop":
        ref = args[-1]
        _, c = container(state, ref)
        if os.environ.get("FAKE_STOP_FAIL") == "true":
            die(f"cannot stop container: {ref}")
        if cut_off_stop_requested():
            stop_in_background(state, ref)
            err("error during connect: connection reset by peer")
            sys.exit(1)
        if c.get("stopping_until") is not None:
            time.sleep(max(0.0, c["stopping_until"] - time.time()))
            state = load()
            _, c = container(state, ref)
        finish_stop(c)
        save(state)
        out(ref)
        return

    if command == "start":
        ref = args[-1]
        _, c = container(state, ref)
        if c["running"]:
            if c.get("state") == "paused":
                die("Error response from daemon: cannot start a paused container, try unpause instead")
            # Docker starts nothing, and resets nothing, for a container that is running, restarting or still stopping.
            out(ref)
            return
        c["running"] = True
        c.pop("state", None)
        c["restart_count"] = 0
        save(state)
        out(ref)
        return

    if command == "rm":
        force = "-f" in args
        ref = args[-1]
        found = resolve(state, ref)
        if found is None:
            if force:
                return
            die(f"No such container: {ref}")
        name, c = found
        if c["running"] and not force:
            die(f"cannot remove container {name}: container is running")
        del state["containers"][name]
        save(state)
        out(ref)
        return

    if command == "rename":
        ref, new = args
        name, c = container(state, ref)
        if new in state["containers"]:
            die(f'Conflict. The container name "/{new}" is already in use')
        state["containers"][new] = c
        del state["containers"][name]
        save(state)
        return

    if command == "update":
        ref = args[-1]
        _, c = container(state, ref)
        if "--restart" in args:
            c["restart"] = args[args.index("--restart") + 1]
        # As Docker (29) updates them: 0 leaves a limit as it is, so a CPU or memory limit cannot be taken off; a
        # process limit of -1 takes it off (inspect then reports 0); a negative memory limit is refused.
        given = limits_of(args[:-1])
        if given.get("memory", 0) < 0:
            die(f'invalid argument "{option_values(args, "--memory")[-1]}" for "-m, --memory" flag: invalid size')
        limits = dict(limits_of(c.get("options", [])), **c.get("limits", {}))
        for key, value in given.items():
            if value != 0:
                limits[key] = 0 if key == "pids" and value < 0 else value
        c["limits"] = limits
        save(state)
        out(ref)
        return

    if command == "cp":
        ref, path = args[0].split(":", 1)
        container(state, ref)
        if path == "/run/secrets":
            if os.environ.get("FAKE_SECRETS_COPY_FAIL") == "true":
                die("Secrets configuration copy unavailable")
            os.mkdir(args[1])
            override = os.environ.get("FAKE_IDENTITY_SECRET_OVERRIDE")
            if override:
                with open(os.path.join(args[1], override), "w") as secret:
                    secret.write("/another/store.json")
            return
        if os.environ.get("FAKE_IDENTITY_SYMLINK") == "true":
            os.symlink(os.environ["FAKE_IDENTITY_SOURCE"], args[1])
            return
        if os.environ.get("FAKE_IDENTITY_COPY_FAIL") == "true":
            die("Identity copy unavailable")
        source = os.environ.get("FAKE_IDENTITY_SOURCE")
        if source:
            with open(source) as incoming:
                document = incoming.read()
        else:
            document = os.environ.get("FAKE_IDENTITY_DOCUMENT", '{"schemaVersion":1}')
        with open(args[1], "w") as output:
            output.write(document)
        return

    if command == "logs":
        container(state, args[-1])
        out("fake controller log line")
        return

    if command == "inspect":
        inspect(state, args)
        return
    if command == "image" and args[:1] == ["inspect"]:
        image_inspect(state, args[1:])
        return
    if command == "pull":
        pull(state, args)
        return
    if command == "ps":
        ps(state, args)
        return

    if command == "run":
        run(state, args, image)
        return

    die(f"fake docker: unsupported command {command}")


def entry():
    code = 0
    try:
        main()
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
    try:
        if sys.stdout is not None:
            sys.stdout.flush()
    except (OSError, ValueError):
        pass
    os._exit(code)


entry()
