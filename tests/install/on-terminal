#!/usr/bin/env python3
"""Runs a command on its own pseudo-terminal, as someone running install.sh in a terminal window or over SSH would.

Usage: on-terminal <log-file> [--expect <text> <answer>]... -- <command> [args...]

The command becomes a session leader with the terminal as its controlling terminal (stdout and stderr; stdin is
/dev/null, so a pipe inside the command is what feeds it). Everything written to the terminal goes to <log-file>. Each
--expect pair is a person at the keyboard: once <text> has appeared on the terminal (after the answer before it), they
type <answer> and Enter. A command still running after ON_TERMINAL_TIMEOUT seconds (default 30), waiting for an answer
nobody gives, is killed with its process group, and this exits 124. Otherwise it exits with the command's status (128 + N
when a signal ended it).
"""
import fcntl
import os
import select
import signal
import sys
import termios
import time


def main():
    arguments = sys.argv[1:]
    log_file = arguments.pop(0)
    answers = []
    while arguments and arguments[0] == "--expect":
        answers.append((arguments[1].encode(), arguments[2].encode() + b"\n"))
        arguments = arguments[3:]
    if not arguments or arguments[0] != "--":
        sys.exit("on-terminal: usage: on-terminal <log-file> [--expect <text> <answer>]... -- <command> [args...]")
    command = arguments[1:]
    deadline = time.monotonic() + float(os.environ.get("ON_TERMINAL_TIMEOUT", "30"))

    master, slave = os.openpty()
    child = os.fork()
    if child == 0:
        os.close(master)
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(slave, 1)
        os.dup2(slave, 2)
        os.close(slave)
        os.close(null)
        os.execvp(command[0], command)
    os.close(slave)

    seen = b""
    status = None
    with open(log_file, "wb") as log:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                os.killpg(child, signal.SIGKILL)
                os.waitpid(child, 0)
                log.write(b"\n[on-terminal: timed out]\n")
                sys.exit(124)
            ready, _, _ = select.select([master], [], [], min(remaining, 0.2))
            if ready:
                try:
                    data = os.read(master, 4096)
                except OSError:
                    data = b""
                if not data:
                    break
                log.write(data)
                log.flush()
                seen += data
                if answers and answers[0][0] in seen:
                    seen = seen[seen.index(answers[0][0]) + len(answers[0][0]):]
                    os.write(master, answers.pop(0)[1])
            elif status is None:
                pid, status_now = os.waitpid(child, os.WNOHANG)
                if pid:
                    status = status_now
            else:
                # The command has gone, and the terminal has had nothing more to say (macOS may never report its end).
                break
    if status is None:
        _, status = os.waitpid(child, 0)
    sys.exit(128 + os.WTERMSIG(status) if os.WIFSIGNALED(status) else os.WEXITSTATUS(status))


main()
