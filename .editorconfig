root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sln,slnx,csproj,props,targets}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

[{Dockerfile,*.dockerfile,docker-compose*.yml}]
indent_style = space
indent_size = 2

[.github/**/*.yml]
indent_style = space
indent_size = 2
